@using System.Globalization
@inject ApiClient Api

@* Formulario del modulo de voz de ElevenLabs. Se usa igual al crear el modulo,
   al editarlo en la pagina Modulos y en el popup "Editar nodo" del pipeline.
   Las voces de la cuenta (predeterminadas, clonadas y guardadas) son casi todas
   en ingles; las nativas de otros idiomas estan en la biblioteca publica de
   ElevenLabs, que se busca por el idioma elegido. Una voz de la biblioteca se
   anade a la cuenta la primera vez que se locuta con ella (lo hace el servidor).
   Acento y estilo filtran la biblioteca; sus opciones son las que tienen de
   verdad las voces del idioma (ElevenLabs no publica la lista). *@

<div class="form-row">
    <div class="form-group">
        <label>Idioma de la voz</label>
        <select value="@Config.Language" @onchange="OnLanguageChanged">
            @foreach (var (value, label) in ElevenLabsVoiceConfig.LanguageOptions)
            {
                <option value="@value">@label</option>
            }
        </select>
    </div>
    @if (!string.IsNullOrEmpty(Config.Language))
    {
        <div class="form-group">
            <label>Acento</label>
            <select value="@Config.Accent" @onchange="OnAccentChanged">
                <option value="">Todos los acentos</option>
                @if (!string.IsNullOrEmpty(Config.Accent) && !_accents.Any(a => a.Value == Config.Accent))
                {
                    <option value="@Config.Accent">@ElevenLabsVoiceConfig.AccentLabel(Config.Accent)</option>
                }
                @foreach (var a in _accents)
                {
                    <option value="@a.Value">@ElevenLabsVoiceConfig.AccentLabel(a.Value) (@a.Count)</option>
                }
            </select>
        </div>
    }
</div>
<div class="form-row">
    @if (!string.IsNullOrEmpty(Config.Language))
    {
        <div class="form-group">
            <label>Estilo</label>
            <select value="@Config.UseCase" @onchange="OnUseCaseChanged">
                <option value="">Todos los estilos</option>
                @if (!string.IsNullOrEmpty(Config.UseCase) && !_useCases.Any(u => u.Value == Config.UseCase))
                {
                    <option value="@Config.UseCase">@ElevenLabsVoiceConfig.UseCaseLabel(Config.UseCase)</option>
                }
                @foreach (var u in _useCases)
                {
                    <option value="@u.Value">@ElevenLabsVoiceConfig.UseCaseLabel(u.Value) (@u.Count)</option>
                }
            </select>
        </div>
    }
    <div class="form-group">
        <label>Voz</label>
        @if (_voices is { Count: > 0 })
        {
            var own = _voices.Where(v => !v.IsLibrary).ToList();
            var library = _voices.Where(v => v.IsLibrary).ToList();
            <select value="@Config.Voice" @onchange="OnVoiceSelected">
                @if (string.IsNullOrEmpty(Config.Voice))
                {
                    <option value="">-- Elige una voz --</option>
                }
                else if (!_voices.Any(v => v.Id == Config.Voice))
                {
                    @* La voz guardada no esta en la lista (otro idioma, borrada o de otra
                       key): se muestra igual para no cambiarla sin que el usuario lo vea. *@
                    <option value="@Config.Voice">@(string.IsNullOrEmpty(Config.VoiceName) ? Config.Voice : Config.VoiceName) (guardada)</option>
                }
                @if (library.Count > 0)
                {
                    <optgroup label="Biblioteca de ElevenLabs · @LibraryLabel()">
                        @foreach (var v in library)
                        {
                            <option value="@v.Id">@v.Label</option>
                        }
                    </optgroup>
                }
                @if (own.Count > 0)
                {
                    <optgroup label="Mis voces">
                        @foreach (var v in own)
                        {
                            <option value="@v.Id">@v.Label</option>
                        }
                    </optgroup>
                }
            </select>
        }
        else
        {
            <input type="text" @bind="Config.Voice" @bind:after="ClearVoiceName" placeholder="Id de la voz (p. ej. JBFqnCBsd6RMkjVDRZzb)" />
        }
    </div>
</div>
<div class="form-group">
    @if (ApiKeyId is null)
    {
        <span class="text-sm text-muted">Elige una API key de ElevenLabs para ver las voces.</span>
    }
    else if (_loading)
    {
        <span class="text-sm text-muted">Cargando voces de ElevenLabs...</span>
    }
    else if (_error is not null)
    {
        <span class="text-sm voice-preview-error">@_error</span>
    }
    else if (!string.IsNullOrEmpty(Config.VoiceOwner))
    {
        <span class="text-sm text-muted">
            Voz de la biblioteca: la primera vez que se use se anadira a "My Voices" de tu cuenta
            de ElevenLabs (ocupa uno de sus huecos de voz).
        </span>
    }
    @if (SelectedSample is { } sample)
    {
        <div class="voice-preview">
            <span class="text-sm text-muted">Muestra de la voz (gratis):</span>
            <audio @key="sample" controls preload="none" src="@sample"></audio>
        </div>
    }
</div>

<div class="form-row">
    @if (ElevenLabsVoiceConfig.SupportsSpeed(Model))
    {
        <div class="form-group">
            <label>Velocidad <span class="text-sm text-muted">(@ElevenLabsVoiceConfig.MinSpeed - @ElevenLabsVoiceConfig.MaxSpeed)</span></label>
            <input type="number" step="0.05" min="@ElevenLabsVoiceConfig.MinSpeed" max="@ElevenLabsVoiceConfig.MaxSpeed" @bind="Config.Speed" />
        </div>
    }
    @* Los sliders van con cultura invariante: Blazor no la aplica solo a type="range"
       y, con la cultura del navegador en espanol, "0.45" se leia como 45. *@
    <div class="form-group voice-slider">
        <label>Estabilidad <span class="voice-slider-value">@Percent(Config.Stability)</span></label>
        <input type="range" min="0" max="1" step="0.05" @bind="Config.Stability" @bind:event="oninput"
               @bind:culture="CultureInfo.InvariantCulture" />
        <small class="voice-slider-hint">Baja = mas expresiva; alta = mas monotona y constante.</small>
    </div>
</div>
<div class="form-row">
    <div class="form-group voice-slider">
        <label>Parecido a la voz <span class="voice-slider-value">@Percent(Config.SimilarityBoost)</span></label>
        <input type="range" min="0" max="1" step="0.05" @bind="Config.SimilarityBoost" @bind:event="oninput"
               @bind:culture="CultureInfo.InvariantCulture" />
        <small class="voice-slider-hint">Cuanto se cine a la voz original.</small>
    </div>
    <div class="form-group voice-slider">
        <label>Exageracion de estilo <span class="voice-slider-value">@Percent(Config.Style)</span></label>
        <input type="range" min="0" max="1" step="0.05" @bind="Config.Style" @bind:event="oninput"
               @bind:culture="CultureInfo.InvariantCulture" />
        <small class="voice-slider-hint">0 recomendado; subirlo da mas caracter pero tarda mas.</small>
    </div>
</div>


@code {
    [Parameter, EditorRequired] public ElevenLabsVoiceConfig Config { get; set; } = new();
    [Parameter] public Guid? ApiKeyId { get; set; }
    [Parameter] public string Model { get; set; } = "";

    private List<VoiceOptionResponse>? _voices;
    private List<VoiceFacetResponse> _accents = [];
    private List<VoiceFacetResponse> _useCases = [];
    private bool _loading;
    private string? _error;
    private (Guid? Key, string Language, string Accent, string UseCase)? _loaded;

    /// <summary>Audio de ejemplo de la voz elegida, alojado en ElevenLabs: oirlo no gasta caracteres.</summary>
    private string? SelectedSample => _voices?.FirstOrDefault(v => v.Id == Config.Voice)?.PreviewUrl;

    protected override Task OnParametersSetAsync() => LoadVoicesAsync();

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        Config.Language = e.Value?.ToString() ?? "";
        // Acentos y estilos son de cada idioma.
        Config.Accent = "";
        Config.UseCase = "";
        await LoadVoicesAsync();
    }

    private async Task OnAccentChanged(ChangeEventArgs e)
    {
        Config.Accent = e.Value?.ToString() ?? "";
        await LoadVoicesAsync();
    }

    private async Task OnUseCaseChanged(ChangeEventArgs e)
    {
        Config.UseCase = e.Value?.ToString() ?? "";
        await LoadVoicesAsync();
    }

    private async Task LoadVoicesAsync()
    {
        // Solo se piden las voces al cambiar de API key, idioma o filtros.
        var wanted = (ApiKeyId, Config.Language, Config.Accent, Config.UseCase);
        if (_loaded == wanted) return;
        _loaded = wanted;
        _voices = null;
        _error = null;
        if (ApiKeyId is not Guid key) return;

        _loading = true;
        var (list, error) = await Api.GetElevenLabsVoicesAsync(key, Config.Language, Config.Accent, Config.UseCase);
        _loading = false;
        if (_loaded != wanted) return; // Cambio de key, idioma o filtro mientras cargaba.

        var voices = list?.Voices;
        _voices = voices;
        _accents = list?.Accents ?? [];
        _useCases = list?.UseCases ?? [];
        _error = voices is null ? error ?? "No se pudieron cargar las voces" : null;
        if (voices is { Count: 0 }) _error = "No hay voces con estos filtros.";
        else if (voices is not null && !string.IsNullOrEmpty(Config.Language) && !voices.Any(v => v.IsLibrary))
            _error = "La biblioteca no tiene voces con estos filtros; prueba con otro acento o estilo.";

        // Sin voz elegida se propone la primera (la mas usada del idioma): el
        // selector no puede quedar vacio.
        if (string.IsNullOrEmpty(Config.Voice) && voices is { Count: > 0 })
            Select(voices.FirstOrDefault(v => v.IsLibrary) ?? voices[0]);
    }

    private void OnVoiceSelected(ChangeEventArgs e)
    {
        var id = e.Value?.ToString() ?? "";
        var voice = _voices?.FirstOrDefault(v => v.Id == id);
        if (voice is not null) Select(voice);
    }

    // Un id escrito a mano ya no es la voz cuyo nombre y dueno estaban guardados.
    private void ClearVoiceName()
    {
        Config.VoiceName = "";
        Config.VoiceOwner = "";
    }

    private void Select(VoiceOptionResponse voice)
    {
        Config.Voice = voice.Id;
        // La etiqueta es "Nombre · detalles": se guarda solo el nombre.
        Config.VoiceName = voice.Label.Split(" · ")[0];
        Config.VoiceOwner = voice.OwnerId ?? "";
    }

    private string LibraryLabel()
    {
        var parts = new List<string> { LanguageLabel(Config.Language) };
        if (!string.IsNullOrEmpty(Config.Accent)) parts.Add(ElevenLabsVoiceConfig.AccentLabel(Config.Accent));
        if (!string.IsNullOrEmpty(Config.UseCase)) parts.Add(ElevenLabsVoiceConfig.UseCaseLabel(Config.UseCase));
        return string.Join(" · ", parts);
    }

    private static string Percent(double value) => $"{Math.Round(value * 100):0} %";

    private static string LanguageLabel(string code) =>
        ElevenLabsVoiceConfig.LanguageOptions.FirstOrDefault(l => l.Value == code).Label ?? code;
}
