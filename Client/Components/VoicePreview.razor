@* Demostracion de voz de los modulos de texto a voz: genera una frase corta con
   la voz, el modelo y la API key del formulario (aunque no esten guardados) y la
   reproduce. Solo lo usa OpenAI: ElevenLabs ya trae una muestra gratis de cada
   voz. El proveedor factura cada escucha, asi que solo se pide al pulsar. *@
@inject ApiClient Api

<div class="voice-preview">
    <button type="button" class="btn btn-xs pb-assist-btn" disabled="@(_loading || ApiKeyId is null)" @onclick="PlayAsync">
        <i class="bi @(_loading ? "bi-hourglass-split" : "bi-play-circle")"></i>
        @(_loading ? "Generando..." : "Escuchar voz")
    </button>
    @if (ApiKeyId is null)
    {
        <span class="text-sm text-muted">Elige una API key para escuchar la voz.</span>
    }
    else if (_error is not null)
    {
        <span class="text-sm voice-preview-error">@_error</span>
    }
    else if (_audioUrl is null)
    {
        <span class="text-sm text-muted">Frase corta de prueba; el proveedor la cobra (centimos o menos).</span>
    }
    @if (_audioUrl is not null)
    {
        @* @key: un elemento nuevo por muestra, para que autoplay suene cada vez. *@
        <audio @key="_audioUrl" controls autoplay src="@_audioUrl"></audio>
        <span class="text-sm text-muted">@_audioLabel</span>
    }
</div>

@code {
    [Parameter] public Guid? ApiKeyId { get; set; }
    [Parameter] public string Model { get; set; } = "";
    [Parameter] public string Voice { get; set; } = "alloy";
    [Parameter] public double Speed { get; set; } = 1.0;
    [Parameter] public string? Instructions { get; set; }

    private bool _loading;
    private string? _error;
    private string? _audioUrl;
    private string? _audioLabel;

    private async Task PlayAsync()
    {
        if (ApiKeyId is null) return;
        _loading = true;
        _error = null;

        var instructions = AiModuleOptions.SupportsVoiceInstructions(Model) ? Instructions : null;
        var (audio, error) = await Api.PreviewVoiceAsync(new VoicePreviewRequest(
            ApiKeyId, Model, Voice, Speed == 1.0 ? null : Speed, instructions));

        _loading = false;
        if (audio is null)
        {
            _error = error ?? "No se pudo generar la muestra";
            return;
        }

        _audioUrl = "data:audio/mpeg;base64," + Convert.ToBase64String(audio);
        _audioLabel = $"Voz {Voice}" + (Speed == 1.0 ? "" : $" a {Speed:0.##}x");
    }
}
