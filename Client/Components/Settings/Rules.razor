@inject ApiClient Api

@*
    Reglas del tenant en dos sub-pestanas:
      - Mis reglas:  filas de la tabla Rules, editables (las que gestiona /api/rules).
      - Constantes:  reglas integradas en el producto (constantes del servidor en
                     OutputSchema.GetTextContentRules), solo lectura.
    Se separan porque el inspector de un modulo las cuenta juntas como "Reglas
    activas" y, sin esta pestana, las constantes no aparecian en ninguna pantalla.

    Las dos admiten excepciones por modulo del catalogo (tabla RuleExceptions): ese
    AiModule deja de recibir la regla en todos los pipelines que lo usen. Se dan de
    alta aqui o con la x del panel del modulo en el editor del pipeline.
*@

<div class="apikeys-page-header">
    <div>
        <h3>Reglas</h3>
        <p class="text-muted" style="font-size:0.85rem; margin:0;">
            Cada regla activa se inyecta automaticamente en el system prompt de TODAS las llamadas a IA del pipeline
            (texto, imagen, coordinador, orquestador, diseno). Usalas para imponer formato, idioma, restricciones de marca, etc.
        </p>
    </div>
    @if (_tab == Tab.Propias)
    {
        <button class="btn btn-primary" @onclick="OpenCreate" style="flex-shrink:0;">+ Nueva Regla</button>
    }
</div>

<div class="rules-subtabs">
    <button class="rules-subtab @(_tab == Tab.Propias ? "is-active" : "")" @onclick="() => _tab = Tab.Propias">
        Mis reglas <span class="tab-count">@_rules.Count</span>
    </button>
    <button class="rules-subtab @(_tab == Tab.Constantes ? "is-active" : "")" @onclick="() => _tab = Tab.Constantes">
        Constantes <span class="tab-count">@ActiveRulesRegistry.BuiltInTextRules.Count</span>
    </button>
</div>

@if (_exceptionError is not null)
{
    <div class="alert alert-error" style="margin-bottom:0.8rem;">@_exceptionError</div>
}

@if (_tab == Tab.Propias)
{
    @if (_rules.Count > 0)
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width:4rem;">Orden</th>
                        <th>Titulo</th>
                        <th>Contenido</th>
                        <th style="width:16rem;">Modulos exceptuados</th>
                        <th style="width:5rem;">Estado</th>
                        <th style="width:10rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _rules)
                    {
                        <tr class="@(!r.IsActive ? "row-inactive" : string.Empty)">
                            <td>@r.SortOrder</td>
                            <td>@r.Title</td>
                            <td class="cell-mono" style="max-width:30rem; white-space:pre-wrap;">@r.Content</td>
                            <td>
                                @{ var claveRegla = ActiveRulesRegistry.TenantKey(r.Id); }
                                <RuleExceptionsCell RuleKey="@claveRegla"
                                                    Exceptions="ExcepcionesDe(claveRegla)"
                                                    Candidates="CandidatosDe(claveRegla)"
                                                    Busy="_savingException"
                                                    OnAdd="AddException"
                                                    OnRemove="RemoveException" />
                            </td>
                            <td>
                                @if (r.IsActive)
                                {
                                    <span class="badge badge-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge">Inactiva</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm" @onclick="() => StartEdit(r)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Delete(r.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-error">
            No se pudieron cargar las reglas: @_loadError
            <button class="btn btn-sm" style="margin-left:0.6rem;" @onclick="Load">Reintentar</button>
        </div>
    }
    else if (!_loading)
    {
        <div class="apikeys-empty">
            <div class="apikeys-empty-icon">📋</div>
            <div class="apikeys-empty-title">Sin reglas propias</div>
            <div class="apikeys-empty-desc">
                Pulsa <strong>+ Nueva Regla</strong> para añadir tu primera regla de system prompt.
                Las que el inspector de un módulo marca como activas sin estar aquí son las de la
                pestaña <strong>Constantes</strong>.
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info" style="font-size:0.85rem; margin-bottom:0.9rem;">
        Vienen con el producto y se aplican siempre a los modulos de @ActiveRulesRegistry.BuiltInTextRulesScope,
        <strong>antes</strong> que tus reglas. No se editan desde aqui: son constantes del servidor
        (<span class="cell-mono">OutputSchema.GetTextContentRules</span>) y cambiarlas exige tocar el codigo y
        redesplegar. Lo que si puedes es <strong>exceptuar modulos</strong>: el modulo que anadas deja de
        recibir esa regla en todos los pipelines que lo usen.
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:9rem;">Categoria</th>
                    <th>Titulo</th>
                    <th>Contenido</th>
                    <th style="width:16rem;">Modulos exceptuados</th>
                    <th style="width:6rem;">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in ActiveRulesRegistry.BuiltInTextRules)
                {
                    <tr>
                        <td>@r.Category</td>
                        <td>@r.Title</td>
                        <td class="cell-mono" style="max-width:30rem; white-space:pre-wrap;">@r.Body</td>
                        <td>
                            @{ var claveConstante = r.Key!; }
                            <RuleExceptionsCell RuleKey="@claveConstante"
                                                    Exceptions="ExcepcionesDe(claveConstante)"
                                                    Candidates="CandidatosDe(claveConstante)"
                                                    Busy="_savingException"
                                                    OnAdd="AddException"
                                                    OnRemove="RemoveException" />
                        </td>
                        <td><span class="badge">Constante</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showModal)
{
    <div class="modal-overlay" @onclick="CancelEdit">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 560px;">
            <div class="modal-header">
                <strong style="flex:1">@(_editingId is null ? "Nueva regla" : "Editar regla")</strong>
                <button class="modal-close-btn" @onclick="CancelEdit" aria-label="Cerrar">&#x2715;</button>
            </div>
            <div class="modal-body">
                @if (_error is not null)
                {
                    <div class="alert alert-error" style="margin-bottom:0.8rem;">@_error</div>
                }
                <div class="form-group">
                    <label>Titulo</label>
                    <input type="text" @bind="_title" placeholder="Idioma de salida" />
                </div>
                <div class="form-group">
                    <label>Contenido (instruccion enviada al modelo)</label>
                    <textarea rows="5" @bind="_content" placeholder="Toda salida debe estar en espanol..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Orden</label>
                        <input type="number" @bind="_sortOrder" style="width:6rem;" />
                    </div>
                    <div class="form-group" style="display:flex; align-items:end;">
                        <label style="display:flex; gap:.5rem; align-items:center;">
                            <input type="checkbox" @bind="_isActive" />
                            <span>Activa</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm" @onclick="CancelEdit" disabled="@_loading">Cancelar</button>
                <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@_loading">
                    @(_loading ? "Guardando..." : (_editingId is null ? "Crear" : "Guardar"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private enum Tab { Propias, Constantes }

    private Tab _tab = Tab.Propias;

    private List<RuleResponse> _rules = [];
    private List<RuleExceptionResponse> _exceptions = [];
    private List<AiModuleResponse> _modules = [];
    private bool _savingException;
    /// <summary>Error de alta/baja de excepcion. Aparte de <c>_loadError</c>, que solo
    /// se pinta cuando la lista de reglas ni siquiera se pudo cargar.</summary>
    private string? _exceptionError;
    private bool _loading;
    private string? _error;
    /// <summary>Error de la ultima carga. Separado de <c>_error</c>, que es el del formulario.</summary>
    private string? _loadError;

    private bool _showModal;
    private Guid? _editingId;
    private string _title = "";
    private string _content = "";
    private bool _isActive = true;
    private int _sortOrder;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var (rules, error) = await Api.GetRulesAsync();
            _rules = rules;
            _loadError = error;
        }
        catch (Exception ex)
        {
            _rules = [];
            _loadError = ex.Message;
        }

        // Las excepciones y el catalogo no bloquean la pantalla: si fallan, las
        // reglas se siguen viendo y solo se queda sin gestion de excepciones.
        try { _exceptions = (await Api.GetRuleExceptionsAsync()).Exceptions; } catch { _exceptions = []; }
        try { _modules = await Api.GetModulesAsync(); } catch { _modules = []; }

        _loading = false;
    }

    // ── Excepciones por modulo ──

    private List<RuleExceptionResponse> ExcepcionesDe(string ruleKey) =>
        _exceptions.Where(x => x.RuleKey == ruleKey).OrderBy(x => x.AiModuleName).ToList();

    /// <summary>Modulos que hoy reciben la regla: los que le aplican por tipo y aun
    /// no estan exceptuados.</summary>
    private List<AiModuleResponse> CandidatosDe(string ruleKey)
    {
        var yaExceptuados = _exceptions.Where(x => x.RuleKey == ruleKey).Select(x => x.AiModuleId).ToHashSet();
        return _modules
            .Where(m => !yaExceptuados.Contains(m.Id))
            .Where(m => ActiveRulesRegistry.RuleAppliesToModuleType(ruleKey, m.ModuleType))
            .OrderBy(m => m.Name)
            .ToList();
    }

    private async Task AddException((string RuleKey, Guid AiModuleId) item)
    {
        if (_savingException) return;
        _savingException = true;
        _exceptionError = null;

        var (created, error) = await Api.CreateRuleExceptionAsync(
            new CreateRuleExceptionRequest(item.RuleKey, item.AiModuleId));

        if (created is not null)
        {
            if (!_exceptions.Any(x => x.Id == created.Id)) _exceptions.Add(created);
        }
        else _exceptionError = error ?? "No se pudo anadir la excepcion";

        _savingException = false;
    }

    private async Task RemoveException(RuleExceptionResponse item)
    {
        if (_savingException) return;
        _savingException = true;
        _exceptionError = null;

        var (ok, error) = await Api.DeleteRuleExceptionAsync(item.Id);
        if (ok) _exceptions.RemoveAll(x => x.Id == item.Id);
        else _exceptionError = error ?? "No se pudo quitar la excepcion";

        _savingException = false;
    }

    private void OpenCreate()
    {
        _editingId = null;
        _title = ""; _content = ""; _isActive = true; _sortOrder = 0; _error = null;
        _showModal = true;
    }

    private void StartEdit(RuleResponse r)
    {
        _editingId = r.Id;
        _title = r.Title;
        _content = r.Content;
        _isActive = r.IsActive;
        _sortOrder = r.SortOrder;
        _error = null;
        _showModal = true;
    }

    private void CancelEdit()
    {
        if (_loading) return;
        _showModal = false;
        _editingId = null;
        _title = ""; _content = ""; _isActive = true; _sortOrder = 0;
        _error = null;
    }

    private async Task Save()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_content))
        {
            _error = "Titulo y contenido son obligatorios";
            return;
        }
        _loading = true;
        try
        {
            (bool ok, string? error) result;
            if (_editingId is { } id)
                result = await Api.UpdateRuleAsync(id, new UpdateRuleRequest(_title, _content, _isActive, _sortOrder));
            else
                result = await Api.CreateRuleAsync(new CreateRuleRequest(_title, _content, _isActive, _sortOrder));

            if (result.ok) { CancelEdit(); await Load(); }
            else _error = result.error;
        }
        catch (Exception ex) { _error = $"Error de conexion: {ex.Message}"; }
        _loading = false;
    }

    private async Task Delete(Guid id)
    {
        try { await Api.DeleteRuleAsync(id); await Load(); } catch { }
    }
}
