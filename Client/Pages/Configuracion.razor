@page "/configuracion"
@page "/configuracion/{Section?}"
@inject NavigationManager Nav

@*
    Configuracion: reune en una sola pagina lo que antes eran cinco (API Keys,
    Redes sociales, Mensajeria, Shopify y Reglas). Cada seccion sigue siendo su
    propio componente, en Components/Settings, y solo se monta la activa: asi
    cada una carga sus datos al abrirla y no se hacen cinco peticiones de golpe.

    La seccion viaja en la URL (/configuracion/reglas) para poder enlazar a una
    concreta desde otras pantallas.
*@

<div class="page-header">
    <div class="page-title">
        <h2>Configuración</h2>
        <p>Conecta proveedores, canales y tiendas, y define las reglas que siguen tus pipelines.</p>
    </div>
</div>

<div class="settings-layout">
    <nav class="settings-nav" aria-label="Secciones de configuracion">
        @foreach (var tab in Tabs)
        {
            <button class="settings-nav-item @(tab.Slug == CurrentSlug ? "is-active" : "")"
                    @onclick="() => Go(tab.Slug)">
                <span class="settings-nav-icon" style="--tone:@tab.Tone"><i class="bi @tab.Icon"></i></span>
                <span class="settings-nav-text">
                    <strong>@tab.Label</strong>
                    <small>@tab.Hint</small>
                </span>
            </button>
        }
    </nav>

    <section class="settings-panel">
        @switch (CurrentSlug)
        {
            case "redes-sociales":
                <SocialConnections />
                break;
            case "mensajeria":
                <Messaging />
                break;
            case "shopify":
                <ShopifyConnections />
                break;
            case "reglas":
                <Rules />
                break;
            default:
                <ApiKeys />
                break;
        }
    </section>
</div>

@code {
    [Parameter] public string? Section { get; set; }

    private sealed record SettingsTab(string Slug, string Label, string Icon, string Hint, string Tone);

    private static readonly SettingsTab[] Tabs =
    [
        new("apikeys", "API Keys", "bi-key", "Claves de los proveedores de IA", "#8b83ff"),
        new("redes-sociales", "Redes sociales", "bi-share", "Cuentas de Buffer para publicar", "#ec4899"),
        new("mensajeria", "Mensajeria", "bi-chat-dots", "Bot de Telegram para aprobaciones", "#22d3ee"),
        new("shopify", "Shopify", "bi-shop", "Tiendas conectadas", "#34d399"),
        new("reglas", "Reglas", "bi-list-check", "Normas obligatorias en ejecuciones", "#f59e0b"),
    ];

    /// <summary>Seccion activa. Una ruta desconocida cae en la primera pestana.</summary>
    private string CurrentSlug =>
        Tabs.Any(t => t.Slug == Section) ? Section! : "apikeys";

    private void Go(string slug) => Nav.NavigateTo($"/configuracion/{slug}");
}
