@page "/projects"
@inject ApiClient Api
@inject NavigationManager Nav

@* La pagina organiza el trabajo en dos niveles: un "proyecto" es una agrupacion
   con titulo y descripcion (ProjectGroup) y dentro viven los pipelines, que son
   los que se editan y ejecutan. La agrupacion es solo organizativa. *@

<div class="page-header">
    <div class="page-title">
        <h2>Proyectos</h2>
        <p>Organiza tus pipelines por cliente, marca o temática y lánzalos desde aquí.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary trash-link" @onclick="GoToTrash"
                title="Pipelines borrados; se pueden restaurar">
            <i class="bi bi-trash3"></i> Papelera
            @if (_trashCount > 0)
            {
                <span class="trash-link-count">@_trashCount</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick="OpenCreateGroupModal"><i class="bi bi-folder-plus"></i> Nuevo proyecto</button>
        <button class="btn btn-primary" @onclick="() => OpenCreateModal(null)"><i class="bi bi-plus-lg"></i> Nuevo pipeline</button>
    </div>
</div>

@if (_loaded && (_groups.Count > 0 || _projects.Count > 0))
{
    @* Resumen rapido: todo sale de los datos ya cargados, sin llamadas extra. *@
    <div class="stat-row">
        <div class="stat-tile">
            <span class="stat-icon tone-violet"><i class="bi bi-folder2"></i></span>
            <div><strong>@_groups.Count</strong><span>Proyectos</span></div>
        </div>
        <div class="stat-tile">
            <span class="stat-icon tone-cyan"><i class="bi bi-diagram-3"></i></span>
            <div><strong>@_projects.Count(p => !p.IsTestProject)</strong><span>Pipelines</span></div>
        </div>
        <div class="stat-tile">
            <span class="stat-icon tone-amber"><i class="bi bi-lightning-charge"></i></span>
            <div><strong>@_projects.Count(p => p.ProjectType == "Trigger")</strong><span>Con trigger</span></div>
        </div>
        <div class="stat-tile">
            <span class="stat-icon tone-green"><i class="bi bi-clock-history"></i></span>
            <div><strong>@_projects.Count(p => (DateTime.UtcNow - p.UpdatedAt.ToUniversalTime()).TotalDays < 7)</strong><span>Activos esta semana</span></div>
        </div>
    </div>

    <div class="page-toolbar">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Buscar pipelines o proyectos..."
                   @bind="_query" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <button class="search-box-clear" title="Limpiar" @onclick='() => _query = ""'><i class="bi bi-x-lg"></i></button>
            }
        </div>
        <div class="seg-filters">
            @foreach (var f in Filters)
            {
                <button class="seg-filter @(_filter == f.Id ? "active" : "")" @onclick="() => _filter = f.Id">
                    <i class="bi @f.Icon"></i> @f.Label
                    <span class="seg-filter-count">@CountFor(f.Id)</span>
                </button>
            }
        </div>
    </div>
}

@if (_pinError is not null)
{
    <div class="alert alert-error">@_pinError</div>
}
@if (_groupError is not null)
{
    <div class="alert alert-error">@_groupError</div>
}

@if (!_loaded)
{
    <PageLoader Variant="cards" Stats="4" Label="Cargando proyectos..." />
}

@foreach (var g in _groups)
{
    var pipelines = PipelinesOf(g);
    // Con filtro activo se ocultan los proyectos sin coincidencias.
    if (FilterActive && pipelines.Count == 0 && !GroupMatches(g)) continue;
    var collapsed = _collapsedGroups.Contains(g.Id) && !FilterActive;
    var tone = ToneFor(g.Name);

    <div class="project-group @(collapsed ? "is-collapsed" : "")" style="--tone:@tone">
        @if (_editingGroupId == g.Id)
        {
            <div class="project-group-edit">
                <div class="form-row">
                    <div class="form-group">
                        <label>Nombre del proyecto</label>
                        <input type="text" @bind="_groupName" />
                    </div>
                    <div class="form-group">
                        <label>Descripcion</label>
                        <input type="text" @bind="_groupDesc" />
                    </div>
                </div>
                <div class="project-card-edit-actions">
                    <button class="btn btn-xs btn-success" @onclick="SaveGroupEdit">Guardar</button>
                    <button class="btn btn-xs" @onclick="CancelGroupEdit">Cancelar</button>
                </div>
            </div>
        }
        else
        {
            <div class="project-group-header" @onclick="() => ToggleGroup(g.Id)">
                <span class="project-group-toggle" title="@(collapsed ? "Desplegar" : "Plegar")">
                    <i class="bi @(collapsed ? "bi-chevron-right" : "bi-chevron-down")"></i>
                </span>
                <span class="project-group-icon"><i class="bi @(collapsed ? "bi-folder-fill" : "bi-folder2-open")"></i></span>
                <div class="project-group-info">
                    <h3>@g.Name <span class="projects-section-count" title="Pipelines en este proyecto">@pipelines.Count</span></h3>
                    @if (!string.IsNullOrWhiteSpace(g.Description))
                    {
                        <p class="project-group-desc">@g.Description</p>
                    }
                </div>
                <div class="project-group-actions" @onclick:stopPropagation="true">
                    <button class="btn btn-xs btn-ghost" @onclick="() => OpenCreateModal(g.Id)"><i class="bi bi-plus-lg"></i> Pipeline</button>
                    <button class="btn btn-xs btn-ghost" @onclick="() => OpenAddPipelinesModal(g)"><i class="bi bi-box-arrow-in-down-right"></i> Anadir existentes</button>
                    <button class="icon-btn" @onclick="() => StartGroupEdit(g)"
                            title="Editar proyecto"><i class="bi bi-pencil"></i></button>
                    <button class="icon-btn icon-btn-danger" @onclick="() => DeleteGroup(g)"
                            title="Eliminar proyecto (sus pipelines no se borran)"><i class="bi bi-trash3"></i></button>
                </div>
            </div>
        }

        @if (!collapsed)
        {
            <div class="project-grid">
                @foreach (var p in pipelines)
                {
                    @PipelineCard(p)
                }
                @if (pipelines.Count == 0 && !FilterActive)
                {
                    <button class="project-card-new" @onclick="() => OpenCreateModal(g.Id)">
                        <i class="bi bi-plus-circle-dotted"></i>
                        <span>Este proyecto aun no tiene pipelines. Crea el primero</span>
                    </button>
                }
            </div>
        }
    </div>
}

@foreach (var block in BuildLooseSections())
{
    @if (block.Title is not null)
    {
        <div class="projects-section-header">
            <i class="bi @(block.IsTest ? "bi-cone-striped" : "bi-inbox")"></i>
            <h3>@block.Title</h3>
            <span class="projects-section-count">@block.Projects.Count</span>
        </div>
    }

    <div class="project-grid @(block.IsTest ? "is-test-section" : "")">
        @foreach (var p in block.Projects)
        {
            @PipelineCard(p)
        }
    </div>
}

@if (_loaded && FilterActive && !AnyVisible())
{
    <div class="empty-hero is-compact">
        <div class="empty-hero-icon"><i class="bi bi-search"></i></div>
        <h3>Sin resultados</h3>
        <p>No hay pipelines que coincidan con la búsqueda o el filtro.</p>
        <button class="btn btn-secondary" @onclick="ClearFilters">Limpiar filtros</button>
    </div>
}

@if (_groups.Count == 0 && _projects.Count == 0 && _loaded)
{
    <div class="empty-hero">
        <div class="empty-hero-icon"><i class="bi bi-diagram-3"></i></div>
        <h3>Crea tu primer pipeline</h3>
        <p>
            Un pipeline conecta módulos de IA en un lienzo visual. Si quieres organizar el trabajo
            por temática o cliente, crea antes un proyecto y agrupa ahí tus pipelines.
        </p>
        <div class="empty-hero-actions">
            <button class="btn btn-secondary" @onclick="OpenCreateGroupModal"><i class="bi bi-folder-plus"></i> Crear proyecto</button>
            <button class="btn btn-primary" @onclick="() => OpenCreateModal(null)"><i class="bi bi-plus-lg"></i> Crear pipeline</button>
        </div>
        <div class="empty-hero-steps">
            <div><span>1</span> Crea el pipeline</div>
            <div><span>2</span> Arrastra y conecta módulos</div>
            <div><span>3</span> Ejecútalo o prográmalo</div>
        </div>
    </div>
}

@* ── Modal: nuevo proyecto (agrupacion) ── *@
@if (_showCreateGroupModal)
{
    <div class="modal-overlay" @onclick="CloseCreateGroupModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span style="font-size:1.1rem; font-weight:600;">Nuevo Proyecto</span>
                <button class="modal-close-btn" @onclick="CloseCreateGroupModal" title="Cerrar">&#x2715;</button>
            </div>
            <div class="modal-body">
                @if (_groupModalError is not null)
                {
                    <div class="alert alert-error">@_groupModalError</div>
                }
                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" @bind="_groupName" placeholder="Marca PetWorld" />
                </div>
                <div class="form-group">
                    <label>Descripcion</label>
                    <textarea @bind="_groupDesc" rows="3" placeholder="Todos los pipelines de contenido de la marca"></textarea>
                    <span class="text-sm text-muted">
                        El proyecto solo organiza: agrupa pipelines para encontrarlos rapido. No afecta a las ejecuciones.
                    </span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn" @onclick="CloseCreateGroupModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="CreateGroup" disabled="@_savingGroup">
                    @(_savingGroup ? "Creando..." : "Crear Proyecto")
                </button>
            </div>
        </div>
    </div>
}

@* ── Modal: anadir pipelines existentes a un proyecto ── *@
@if (_addTargetGroup is not null)
{
    var candidates = PipelinesOutside(_addTargetGroup.Id);
    <div class="modal-overlay" @onclick="CloseAddPipelinesModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span style="font-size:1.1rem; font-weight:600;">Anadir pipelines a @_addTargetGroup.Name</span>
                <button class="modal-close-btn" @onclick="CloseAddPipelinesModal" title="Cerrar">&#x2715;</button>
            </div>
            <div class="modal-body">
                @if (_addError is not null)
                {
                    <div class="alert alert-error">@_addError</div>
                }
                @if (candidates.Count == 0)
                {
                    <p class="text-muted">Todos los pipelines estan ya en este proyecto.</p>
                }
                else
                {
                    <div class="pipeline-picker">
                        @foreach (var p in candidates)
                        {
                            var currentGroup = GroupName(p.ProjectGroupId);
                            <label class="pipeline-picker-item">
                                <input type="checkbox"
                                       checked="@_addSelection.Contains(p.Id)"
                                       @onchange="e => ToggleAddSelection(p.Id, e)" />
                                <span class="pipeline-picker-name">@p.Name</span>
                                @if (currentGroup is not null)
                                {
                                    <span class="pipeline-picker-group" title="Se movera desde este proyecto">@currentGroup</span>
                                }
                            </label>
                        }
                    </div>
                    <span class="text-sm text-muted">
                        Un pipeline solo puede estar en un proyecto: los que ya esten en otro se mueven aqui.
                    </span>
                }
            </div>
            <div class="modal-footer">
                <button class="btn" @onclick="CloseAddPipelinesModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="ConfirmAddPipelines"
                        disabled="@(_addSelection.Count == 0 || _savingGroup)">
                    @(_savingGroup ? "Anadiendo..." : $"Anadir ({_addSelection.Count})")
                </button>
            </div>
        </div>
    </div>
}

@* ── Modal: nuevo pipeline ── *@
@if (_showCreateModal)
{
    <div class="modal-overlay" @onclick="CloseCreateModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <span style="font-size:1.1rem; font-weight:600;">Nuevo Pipeline</span>
                <button class="modal-close-btn" @onclick="CloseCreateModal" title="Cerrar">&#x2715;</button>
            </div>
            <div class="modal-body">
                @if (_error is not null)
                {
                    <div class="alert alert-error">@_error</div>
                }
                <div class="form-row">
                    <div class="form-group">
                        <label>Nombre</label>
                        <input type="text" @bind="_name" placeholder="Mi pipeline de IA" />
                    </div>
                    <div class="form-group">
                        <label>Descripcion</label>
                        <input type="text" @bind="_desc" placeholder="Pipeline que genera texto e imagen" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Tipo de pipeline</label>
                        <select @bind="_createType">
                            <option value="Normal">Normal</option>
                            <option value="Trigger">Trigger</option>
                        </select>
                        <span class="text-sm text-muted">
                            @(_createType == "Trigger"
                                ? "Se ejecuta solo cuando ocurre un evento."
                                : "Se ejecuta a mano o con una programacion.")
                        </span>
                    </div>
                    @if (_createType == "Trigger")
                    {
                        <div class="form-group">
                            <label>Tipo de trigger</label>
                            <select @bind="_createTriggerType">
                                <option value="">Sin definir</option>
                                @foreach (var t in _triggerTypes)
                                {
                                    <option value="@t.Id">@t.Label</option>
                                }
                            </select>
                            <span class="text-sm text-muted">Se configura en el nodo Trigger del pipeline.</span>
                        </div>
                    }
                </div>
                <div class="form-group">
                    <label>Proyecto</label>
                    <select @bind="_createGroupSel">
                        <option value="">Sin proyecto</option>
                        @foreach (var g in _groups)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                    <span class="text-sm text-muted">Solo organiza el listado; puedes cambiarlo despues.</span>
                </div>
                <div class="form-group">
                    <label>Contexto del pipeline</label>
                    <textarea @bind="_context" rows="4" placeholder="Ej: Este pipeline genera contenido para una marca de mascotas llamada 'PetWorld'. El tono debe ser amigable, cercano y dirigido a duenos de perros y gatos. Las imagenes deben incluir mascotas felices."></textarea>
                    <span class="text-sm text-muted">Este contexto se inyecta automaticamente en todos los modulos del pipeline.</span>
                </div>
                <div class="form-group">
                    <label class="project-test-toggle">
                        <input type="checkbox" @bind="_isTestProject" />
                        <span>Pipeline de prueba</span>
                    </label>
                    <span class="text-sm text-muted">Se agrupa en la seccion "Pipelines de prueba", al final del listado.</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn" @onclick="CloseCreateModal">Cancelar</button>
                <button class="btn btn-primary" @onclick="Create" disabled="@_loading">
                    @(_loading ? "Creando..." : "Crear Pipeline")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProjectResponse> _projects = [];
    private List<ProjectGroupResponse> _groups = [];
    private readonly HashSet<Guid> _collapsedGroups = [];
    private int _trashCount;
    private bool _loading;
    private bool _loaded;

    // Busqueda y filtro del listado (solo en cliente).
    private string _query = "";
    private string _filter = "all";

    private sealed record FilterOption(string Id, string Label, string Icon);
    private static readonly FilterOption[] Filters =
    [
        new("all", "Todos", "bi-grid"),
        new("pinned", "Fijados", "bi-pin-angle"),
        new("trigger", "Trigger", "bi-lightning-charge"),
        new("test", "Prueba", "bi-cone-striped"),
    ];

    // Colores de acento para avatares y proyectos; se eligen por el nombre para
    // que cada uno conserve siempre el mismo.
    private static readonly string[] Tones =
        ["#6c63ff", "#22d3ee", "#10b981", "#f59e0b", "#ec4899", "#8b5cf6", "#3b82f6", "#14b8a6", "#f43f5e"];
    private string? _error;
    private string? _pinError;
    private string? _groupError;

    // Alta de pipeline
    private bool _showCreateModal;
    private string _name = "";
    private string _desc = "";
    private string _context = "";
    private bool _isTestProject;
    private string _createGroupSel = "";
    private string _createType = "Normal";
    private string _createTriggerType = "";
    private List<TriggerTypeResponse> _triggerTypes = [];

    // Alta y edicion de proyecto (agrupacion)
    private bool _showCreateGroupModal;
    private bool _savingGroup;
    private string? _groupModalError;
    private Guid? _editingGroupId;
    private string _groupName = "";
    private string _groupDesc = "";

    // Anadir pipelines existentes a un proyecto
    private ProjectGroupResponse? _addTargetGroup;
    private readonly HashSet<Guid> _addSelection = [];
    private string? _addError;

    // Edicion de pipeline
    private Guid? _editingId;
    private string _editName = "";
    private string _editDesc = "";
    private string _editContext = "";
    private bool _editIsTest;
    private string _editGroupSel = "";

    /// <summary>Tarjeta de un pipeline. Se pinta igual dentro de un proyecto que fuera de el.</summary>
    private RenderFragment<ProjectResponse> PipelineCard => p =>
        @<div class="project-card @(p.IsPinned ? "is-pinned" : "") @(p.IsTestProject ? "is-test" : "")">
            @if (_editingId == p.Id)
            {
                <div class="project-card-edit">
                    <div class="form-group">
                        <label>Nombre</label>
                        <input type="text" @bind="_editName" />
                    </div>
                    <div class="form-group">
                        <label>Descripcion</label>
                        <input type="text" @bind="_editDesc" />
                    </div>
                    <div class="form-group">
                        <label>Proyecto</label>
                        <select @bind="_editGroupSel">
                            <option value="">Sin proyecto</option>
                            @foreach (var g in _groups)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Contexto</label>
                        <textarea @bind="_editContext" rows="2"></textarea>
                    </div>
                    <label class="project-test-toggle" title="Los pipelines de prueba se agrupan en una seccion aparte al final del listado">
                        <input type="checkbox" @bind="_editIsTest" />
                        <span>Pipeline de prueba</span>
                    </label>
                    <div class="project-card-edit-actions">
                        <button class="btn btn-xs btn-success" @onclick="SaveEdit">Guardar</button>
                        <button class="btn btn-xs" @onclick="CancelEdit">Cancelar</button>
                    </div>
                </div>
            }
            else
            {
                <div class="project-card-body" @onclick="() => GoTo(p.Id)">
                    <div class="project-card-top">
                        <div class="project-card-avatar" style="--tone:@ToneFor(p.Name)">@(p.Name.Length > 0 ? p.Name[0].ToString().ToUpper() : "P")</div>
                        <div class="project-card-badges">
                            @if (p.ProjectType == "Trigger")
                            {
                                <span class="project-card-trigger-badge" title="@TriggerTitle(p)"><i class="bi bi-lightning-charge"></i> trigger</span>
                            }
                            @if (p.IsTestProject)
                            {
                                <span class="project-card-test-badge" title="Pipeline de prueba">prueba</span>
                            }
                        </div>
                    </div>
                    <div class="project-card-title">
                        @if (p.IsPinned)
                        {
                            <i class="bi bi-pin-angle-fill project-card-pin-badge" title="Pipeline fijado"></i>
                        }
                        @p.Name
                    </div>
                    <div class="project-card-desc">@(p.Description ?? "Sin descripcion")</div>
                    @if (!string.IsNullOrEmpty(p.Context))
                    {
                        <div class="project-card-context"><i class="bi bi-quote"></i> @Truncate(p.Context, 90)</div>
                    }
                    <div class="project-card-meta">
                        <span title="Creado el @p.CreatedAt.ToString("dd MMM yyyy")">
                            <i class="bi bi-calendar3"></i> @p.CreatedAt.ToString("dd MMM yyyy")
                        </span>
                        <span title="Ultima actualizacion">
                            <i class="bi bi-arrow-repeat"></i> @RelativeTime(p.UpdatedAt)
                        </span>
                        <span class="project-card-open">Abrir <i class="bi bi-arrow-right"></i></span>
                    </div>
                </div>
                <div class="project-card-actions">
                    <button class="project-action-btn action-pin @(p.IsPinned ? "is-pinned" : "")"
                            @onclick="() => TogglePin(p)"
                            aria-pressed="@p.IsPinned.ToString().ToLowerInvariant()"
                            title="@(p.IsPinned ? "Desfijar pipeline" : "Fijar pipeline")"><i class="bi @(p.IsPinned ? "bi-pin-angle-fill" : "bi-pin-angle")"></i></button>
                    <button class="project-action-btn action-edit" @onclick="() => StartEdit(p)" title="Editar"><i class="bi bi-pencil"></i></button>
                    <button class="project-action-btn action-duplicate" @onclick="() => Duplicate(p.Id)" title="Duplicar"><i class="bi bi-copy"></i></button>
                    <button class="project-action-btn action-delete" @onclick="() => Delete(p.Id)"
                            title="Mover a la papelera"><i class="bi bi-trash3"></i></button>
                </div>
            }
        </div>;

    /// <summary>Un bloque del listado fuera de los proyectos: primero los pipelines sin
    /// agrupar y despues los de prueba. Solo se devuelven las secciones con contenido.</summary>
    private sealed record PipelineSection(string? Title, bool IsTest, List<ProjectResponse> Projects);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        try
        {
            _groups = await Api.GetProjectGroupsAsync();
            _projects = await Api.GetProjectsAsync();
            if (_triggerTypes.Count == 0) _triggerTypes = await Api.GetTriggerTypesAsync();
            _trashCount = (await Api.GetTrashedProjectsAsync()).Count;
        }
        catch { }
        _loading = false;
        _loaded = true;
    }

    private bool FilterActive => !string.IsNullOrWhiteSpace(_query) || _filter != "all";

    private bool PassesFilter(ProjectResponse p) => _filter switch
    {
        "pinned" => p.IsPinned,
        "trigger" => p.ProjectType == "Trigger",
        "test" => p.IsTestProject,
        _ => true,
    };

    private bool TextMatches(string? text) =>
        !string.IsNullOrEmpty(text) && text.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool GroupMatches(ProjectGroupResponse g) =>
        !string.IsNullOrWhiteSpace(_query) && _filter == "all" && (TextMatches(g.Name) || TextMatches(g.Description));

    /// <summary>Visible con el filtro actual. Si el nombre del proyecto coincide con la
    /// busqueda se muestran todos sus pipelines.</summary>
    private bool IsVisible(ProjectResponse p, ProjectGroupResponse? group)
    {
        if (!PassesFilter(p)) return false;
        if (string.IsNullOrWhiteSpace(_query)) return true;
        return TextMatches(p.Name) || TextMatches(p.Description)
            || (group is not null && (TextMatches(group.Name) || TextMatches(group.Description)));
    }

    private bool AnyVisible() => _projects.Any(p =>
        IsVisible(p, p.ProjectGroupId is { } id ? _groups.FirstOrDefault(g => g.Id == id) : null));

    private int CountFor(string filterId) => filterId switch
    {
        "pinned" => _projects.Count(p => p.IsPinned),
        "trigger" => _projects.Count(p => p.ProjectType == "Trigger"),
        "test" => _projects.Count(p => p.IsTestProject),
        _ => _projects.Count,
    };

    private void ClearFilters()
    {
        _query = "";
        _filter = "all";
    }

    private static string ToneFor(string? name)
    {
        var hash = 0;
        foreach (var c in name ?? "") hash = unchecked(hash * 31 + c);
        return Tones[(hash & int.MaxValue) % Tones.Length];
    }

    /// <summary>Pipelines de un proyecto, con el mismo criterio de orden que el listado
    /// general: los de prueba al final y, dentro de cada grupo, fijados y mas recientes primero.</summary>
    private List<ProjectResponse> PipelinesOf(ProjectGroupResponse group) => Sort(
        _projects.Where(p => p.ProjectGroupId == group.Id && IsVisible(p, group)));

    /// <summary>Pipelines que todavia no estan en ese proyecto (candidatos a anadir).</summary>
    private List<ProjectResponse> PipelinesOutside(Guid groupId) => _projects
        .Where(p => p.ProjectGroupId != groupId)
        .OrderBy(p => p.Name)
        .ToList();

    /// <summary>Secciones de los pipelines que no pertenecen a ningun proyecto. El titulo
    /// "Sin proyecto" solo aparece si hay algun proyecto creado: sin ellos seria ruido.</summary>
    private List<PipelineSection> BuildLooseSections()
    {
        var sections = new List<PipelineSection>();
        var loose = _projects.Where(p => p.ProjectGroupId is null && IsVisible(p, null)).ToList();

        var real = Sort(loose.Where(p => !p.IsTestProject));
        if (real.Count > 0)
            sections.Add(new PipelineSection(_groups.Count > 0 ? "Sin proyecto" : null, false, real));

        var tests = Sort(loose.Where(p => p.IsTestProject));
        if (tests.Count > 0)
            sections.Add(new PipelineSection("Pipelines de prueba", true, tests));

        return sections;
    }

    /// <summary>Mismo criterio que el backend: los de prueba al final, dentro de cada grupo
    /// los fijados primero y luego por fecha de creacion.</summary>
    private static List<ProjectResponse> Sort(IEnumerable<ProjectResponse> projects) => projects
        .OrderBy(x => x.IsTestProject)
        .ThenByDescending(x => x.IsPinned)
        .ThenByDescending(x => x.CreatedAt)
        .ToList();

