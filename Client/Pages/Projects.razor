    /// <summary>
    /// Fija o desfija un pipeline. Actualiza la tarjeta al momento y solo revierte
    /// si el backend rechaza el cambio, para no esperar a recargar todo el listado.
    /// </summary>
    private async Task TogglePin(ProjectResponse p)
    {
        var idx = _projects.FindIndex(x => x.Id == p.Id);
        if (idx < 0) return;

        _pinError = null;
        var snapshot = _projects.ToList();

        _projects[idx] = p with { IsPinned = !p.IsPinned };

        try
        {
            var (ok, error) = await Api.SetProjectPinAsync(p.Id, !p.IsPinned);
            if (!ok)
            {
                _projects = snapshot;
                _pinError = error ?? "No se pudo cambiar el estado de fijado.";
            }
        }
        catch (Exception ex)
        {
            _projects = snapshot;
            _pinError = $"Error de conexion: {ex.Message}";
        }
    }

    private void StartEdit(ProjectResponse p)
    {
        _editingId = p.Id;
        _editName = p.Name;
        _editDesc = p.Description ?? "";
        _editContext = p.Context ?? "";
        _editIsTest = p.IsTestProject;
        _editGroupSel = p.ProjectGroupId?.ToString() ?? "";
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEdit()
    {
        if (_editingId is null) return;
        var id = _editingId.Value;
        try
        {
            var req = new UpdateProjectRequest(
                _editName,
                string.IsNullOrWhiteSpace(_editDesc) ? null : _editDesc,
                string.IsNullOrWhiteSpace(_editContext) ? null : _editContext,
                _editIsTest);
            var (ok, _) = await Api.UpdateProjectAsync(id, req);
            if (!ok) return;

            // El proyecto al que pertenece viaja aparte: es una relacion, no un campo
            // del pipeline, y solo se toca si el usuario la ha cambiado.
            var newGroup = ParseGroup(_editGroupSel);
            var current = _projects.FirstOrDefault(x => x.Id == id)?.ProjectGroupId;
            if (newGroup != current) await Api.SetProjectGroupAsync(id, newGroup);

            _editingId = null;
            await Load();
        }
        catch { }
    }

