@page "/modules"
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api

@* Cabecera de página: título, resumen y botón que abre el modal de creación.
   El formulario de creación no ocupa espacio permanente en la página; se abre bajo demanda. *@
<div class="page-header">
    <div class="page-title">
        <h2>Módulos IA</h2>
        <p>Piezas reutilizables con su proveedor, modelo y configuración. Úsalas en cualquier pipeline.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="OpenCreateWizard">
            <i class="bi bi-plus-lg"></i> Nuevo módulo
        </button>
    </div>
</div>

@if (!_loaded)
{
    <PageLoader Variant="table" Rows="6" Stats="4" Label="Cargando modulos..." />
}

@* Resumen y buscador: solo cuando el usuario tiene al menos un módulo propio. *@
@if (_loaded && UserModules.Count > 0)
{
    var withoutKey = UserModules.Count(NeedsKey);
    <div class="stat-row">
        <div class="stat-tile">
            <span class="stat-icon tone-violet"><i class="bi bi-boxes"></i></span>
            <div><strong>@UserModules.Count</strong><span>Módulos</span></div>
        </div>
        <div class="stat-tile">
            <span class="stat-icon tone-cyan"><i class="bi bi-diagram-2"></i></span>
            <div><strong>@UserModules.Select(m => m.ModuleType).Distinct().Count()</strong><span>Tipos distintos</span></div>
        </div>
        <div class="stat-tile">
            <span class="stat-icon tone-green"><i class="bi bi-plug"></i></span>
            <div><strong>@UserModules.Select(m => m.ProviderType).Distinct().Count()</strong><span>Proveedores</span></div>
        </div>
        <div class="stat-tile @(withoutKey > 0 ? "is-warning" : "")">
            <span class="stat-icon tone-amber"><i class="bi bi-key"></i></span>
            <div><strong>@withoutKey</strong><span>Sin API key</span></div>
        </div>
    </div>

    <div class="page-toolbar">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" @bind="_search" @bind:event="oninput"
                   placeholder="Buscar por nombre, proveedor o modelo..." />
            @if (!string.IsNullOrEmpty(_search))
            {
                <button class="search-box-clear" @onclick="ClearSearch" title="Limpiar"><i class="bi bi-x-lg"></i></button>
            }
        </div>
        <div class="seg-filters">
            <button class="seg-filter @(_providerFilter is null ? "active" : "")" @onclick="() => _providerFilter = null">
                Todos <span class="seg-filter-count">@UserModules.Count</span>
            </button>
            @foreach (var prov in UserModules.Select(m => m.ProviderType).Distinct().OrderBy(x => x))
            {
                <button class="seg-filter @(_providerFilter == prov ? "active" : "")" @onclick="() => _providerFilter = prov">
                    <ProviderIcon Provider="@prov" Size="13" /> @prov
                    <span class="seg-filter-count">@UserModules.Count(m => m.ProviderType == prov)</span>
                </button>
            }
        </div>
    </div>
}

@* Asistente de creacion de modulo, en cuatro pasos: proveedor, tipo, modelo y
   resumen. Clic en el fondo o en la X cierra sin guardar (CloseCreateModal); el
   clic dentro del contenido no se propaga al fondo. *@
@if (_showCreateModal)
{
    var wizardModel = GetSelectedModel();
    <div class="modal-overlay" @onclick="CloseCreateModal">
        <div class="modal-content module-wizard" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div class="settings-modal-title">
                    <span class="settings-modal-icon"><i class="bi bi-boxes"></i></span>
                    <div>
                        <h3>Nuevo módulo</h3>
                        <p>@WizardSubtitle()</p>
                    </div>
                </div>
                <button class="btn-icon" title="Cerrar" @onclick="CloseCreateModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <ol class="wizard-steps">
                @foreach (var (num, label) in WizardSteps)
                {
                    var done = num < _wizardStep;
                    <li class="wizard-step @(num == _wizardStep ? "is-active" : "") @(done ? "is-done" : "")">
                        <button disabled="@(!done)" @onclick="() => _wizardStep = num">
                            <span class="wizard-step-num">@if (done) { <i class="bi bi-check-lg"></i> } else { @num }</span>
                            <span class="wizard-step-label">@label</span>
                        </button>
                    </li>
                }
            </ol>

            <div class="modal-body wizard-body">
                @if (_error is not null)
                {
                    <div class="alert alert-error">@_error</div>
                }

                @switch (_wizardStep)
                {
                    case 1:
                        @* ── Paso 1: proveedor ── *@
                        <div class="wizard-providers">
                            @foreach (var prov in ProviderOptions)
                            {
                                var types = AllModels.Where(m => m.Provider == prov.Id).SelectMany(m => m.Types).Where(t => t != "Publish").Distinct().Count();
                                var models = AllModels.Count(m => m.Provider == prov.Id);
                                var keys = _keys.Count(k => k.ProviderType.Equals(prov.Id, StringComparison.OrdinalIgnoreCase));
                                <button class="wizard-provider @(_provider == prov.Id ? "is-selected" : "")" @onclick="() => SelectProvider(prov.Id)">
                                    <span class="wizard-provider-logo"><ProviderIcon Provider="@prov.Id" Size="34" /></span>
                                    <strong>@prov.Label</strong>
                                    <span class="wizard-provider-tag">@prov.Tagline</span>
                                    <span class="wizard-provider-meta">
                                        <span>@models @(models == 1 ? "modelo" : "modelos")</span>
                                        <span>@types @(types == 1 ? "tipo" : "tipos")</span>
                                    </span>
                                    @if (keys > 0)
                                    {
                                        <span class="wizard-provider-key is-ok" title="Tienes API key de este proveedor"><i class="bi bi-key-fill"></i></span>
                                    }
                                </button>
                            }
                        </div>
                        break;

                    case 2:
                        @* ── Paso 2: tipo. Los tres principales en grande; el resto debajo. ── *@
                        var available = GetAvailableTypes().Select(t => t.Value).ToHashSet();
                        <div class="wizard-main-types">
                            @foreach (var t in MainTypes)
                            {
                                var meta = TypeMetaFor(t);
                                var enabled = available.Contains(t);
                                <button class="wizard-type is-@t.ToLowerInvariant() @(enabled ? "" : "is-disabled") @(_moduleType == t ? "is-selected" : "")"
                                        style="--tone:@meta.Tone" disabled="@(!enabled)"
                                        title="@(enabled ? meta.Description : $"No disponible con {ProviderLabel(_provider)}")"
                                        @onclick="() => SelectType(t)">
                                    <span class="wizard-type-art" aria-hidden="true">
                                        @if (t == "Text")
                                        {
                                            <span class="art-text"><span></span><span></span><span></span><i class="art-caret"></i></span>
                                        }
                                        else if (t == "Image")
                                        {
                                            <span class="art-image"><i class="art-sun"></i><i class="art-hill art-hill-1"></i><i class="art-hill art-hill-2"></i></span>
                                        }
                                        else
                                        {
                                            <span class="art-video"><i class="art-ring"></i><i class="art-ring art-ring-2"></i><i class="bi bi-play-fill"></i></span>
                                        }
                                    </span>
                                    <strong>@meta.Label</strong>
                                    <span class="wizard-type-desc">@meta.Description</span>
                                    @if (!enabled)
                                    {
                                        <span class="wizard-type-off">No disponible con @ProviderLabel(_provider)</span>
                                    }
                                </button>
                            }
                        </div>

                        var others = GetAvailableTypes().Where(t => !MainTypes.Contains(t.Value)).ToList();
                        @if (others.Count > 0)
                        {
                            <div class="wizard-section-label">Otros tipos</div>
                            <div class="wizard-other-types">
                                @foreach (var t in others)
                                {
                                    var meta = TypeMetaFor(t.Value);
                                    <button class="wizard-type-small @(_moduleType == t.Value ? "is-selected" : "")" style="--tone:@meta.Tone"
                                            title="@meta.Description" @onclick="() => SelectType(t.Value)">
                                        <span class="wizard-type-small-icon"><i class="bi @meta.Icon"></i></span>
                                        <span class="wizard-type-small-text">
                                            <strong>@t.Label</strong>
                                            <small>@meta.Description</small>
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        break;

                    case 3:
                        @* ── Paso 3: modelo, como elegir personaje: cada uno con sus estadisticas. ── *@
                        var candidates = GetAvailableModels();
                        var stats = ComputeStats(candidates);
                        <div class="wizard-models">
                            @foreach (var m in candidates)
                            {
                                var st = stats[m.Id];
                                var lc = GetLifecycle(m.Id);
                                <button class="wizard-model @(_model == m.Id ? "is-selected" : "") @(lc?.Status == "retired" ? "is-retired" : "")"
                                        @onclick="() => SelectModel(m.Id)" @ondblclick="() => { SelectModel(m.Id); GoToSummary(); }">
                                    @if (m.Description.Contains("Recomendado", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="wizard-model-ribbon"><i class="bi bi-star-fill"></i> Recomendado</span>
                                    }
                                    <span class="wizard-model-head">
                                        <span class="wizard-model-avatar"><ProviderIcon Provider="@m.Provider" Size="22" /></span>
                                        <span class="wizard-model-name">
                                            <strong>@m.DisplayName</strong>
                                            <small>@m.Id</small>
                                        </span>
                                        @if (_model == m.Id)
                                        {
                                            <span class="wizard-model-check"><i class="bi bi-check-lg"></i></span>
                                        }
                                    </span>
                                    <span class="wizard-model-desc">@m.Description</span>
                                    <span class="wizard-stats">
                                        @foreach (var stat in st.Bars)
                                        {
                                            <span class="wizard-stat">
                                                <span class="wizard-stat-label"><i class="bi @stat.Icon"></i> @stat.Label</span>
                                                <span class="wizard-stat-track"><span class="wizard-stat-fill" style="--w:@(stat.Percent)%; --tone:@stat.Tone"></span></span>
                                                <span class="wizard-stat-value">@stat.Value</span>
                                            </span>
                                        }
                                    </span>
                                    <span class="wizard-model-caps">
                                        @foreach (var cap in m.Capabilities)
                                        {
                                            <span class="cap-chip">@CapLabelEs(cap)</span>
                                        }
                                        <ModelLifecycleBadge Info="@lc" Compact="true" />
                                    </span>
                                </button>
                            }
                        </div>
                        break;

                    default:
                        @* ── Paso 4: resumen y datos del modulo ── *@
                        <div class="wizard-summary-layout">
                            <aside class="wizard-summary-card">
                                <span class="wizard-summary-logo"><ProviderIcon Provider="@_provider" Size="30" /></span>
                                <strong class="wizard-summary-model">@(wizardModel?.DisplayName ?? _model)</strong>
                                <span class="wizard-summary-id">@_model</span>
                                <dl>
                                    <dt>Proveedor</dt><dd>@ProviderLabel(_provider)</dd>
                                    <dt>Tipo</dt><dd>@(GetAvailableTypes().FirstOrDefault(t => t.Value == _moduleType)?.Label ?? _moduleType)</dd>
                                    @if (wizardModel is not null)
                                    {
                                        var sumStats = ComputeStats(GetAvailableModels())[wizardModel.Id];
                                        @foreach (var stat in sumStats.Bars)
                                        {
                                            <dt>@stat.Label</dt><dd>@stat.Value</dd>
                                        }
                                    }
                                </dl>
                                @if (wizardModel is not null)
                                {
                                    <p class="wizard-summary-desc">@wizardModel.Description</p>
                                }
                                <ModelLifecycleBadge Info="@GetLifecycle(_model)" />
                            </aside>

                            <div class="wizard-summary-form">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Nombre del modulo</label>
                                        <input type="text" @bind="_name" placeholder="Ej: GPT-4o para textos" />
                                    </div>
                                    <div class="form-group">
                                        <label>Descripcion</label>
                                        <input type="text" @bind="_desc" placeholder="Descripcion opcional" />
                                    </div>
                                </div>

        <!-- API Key (filtered by provider) — hidden for System provider -->
        @if (_provider != "System")
        {
            <div class="form-group">
                <label>API Key (@_provider)</label>
                <select @bind="_apiKeyId">
                    <option value="">-- Seleccionar --</option>
                    @foreach (var k in _keys.Where(k => k.ProviderType.Equals(_provider, StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@k.Id">@k.Name</option>
                    }
                </select>
                @if (!_keys.Any(k => k.ProviderType.Equals(_provider, StringComparison.OrdinalIgnoreCase)))
                {
                    <span class="text-sm text-muted">No tienes API keys de @_provider. <a href="/configuracion/apikeys">Crear una</a></span>
                }
                @if (_provider == SearchConsoleConfig.Provider)
                {
                    <span class="text-sm text-muted">Es el JSON de una cuenta de servicio de Google Cloud anadida como usuario de la propiedad en Search Console.</span>
                }
            </div>
        }

        <!-- Dynamic Configuration (provider + type specific) -->
        <fieldset class="config-fieldset">
            <legend>Configuracion</legend>

            @if (_moduleType is "Text" or "Orchestrator" or "Coordinator")
            {
                <div class="form-group">
                    <label>System Prompt @(_moduleType == "Orchestrator" ? "(se combina con instrucciones del orquestador)" : _moduleType == "Coordinator" ? "(instrucciones para coordinar las entradas)" : "")</label>
                    <textarea @bind="_systemPrompt" rows="3" placeholder="@(_moduleType == "Coordinator" ? "Ej: Recibiras datos de varias entradas (imagenes, textos). Genera un JSON array de recursos..." : _moduleType == "Orchestrator" ? "Ej: Prioriza videos de stock sobre generacion. Maximo 5 tareas por plan." : "Ej: Eres un asistente experto en...")"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Temperatura <span class="text-sm text-muted">(0.0 - 2.0)</span></label>
                        <input type="number" step="0.1" min="0" max="2" @bind="_temperature" />
                    </div>
                    <div class="form-group">
                        <label>Max Tokens</label>
                        <input type="number" min="1" max="200000" @bind="_maxTokens" />
                    </div>
                </div>
                @if (AiModuleOptions.SupportsWebSearch(_provider, _moduleType))
                {
                    <div class="form-group">
                        <label class="form-check">
                            <input type="checkbox" @bind="_webSearch" />
                            Busqueda en internet
                            <span class="text-sm text-muted">(puede buscar y leer paginas web; cada busqueda tiene coste)</span>
                        </label>
                    </div>
                }
                @if (AiModuleOptions.SupportsReasoningEffort(_provider, _model))
                {
                    <div class="form-group">
                        <label>
                            Esfuerzo de razonamiento
                            <span class="text-sm text-muted">(los tokens de razonamiento se facturan como salida)</span>
                        </label>
                        <select @bind="_reasoningEffort">
                            @foreach (var (value, label) in AiModuleOptions.ReasoningEffortOptions)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </div>
                }
            }
            else if (_moduleType == "Image" && _provider == "OpenAI")
            {
                <div class="form-group">
                    <label>Instrucciones <span class="text-sm text-muted">(se añaden al inicio del prompt)</span></label>
                    <textarea @bind="_systemPrompt" rows="3" placeholder="Ej: Siempre usa un estilo fotorrealista, colores vibrantes y fondo neutro..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Tamano</label>
                        <select @bind="_imageSize">
                            @foreach (var s in GetImageSizes())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    @if (AiModuleOptions.SupportsQuality(_model))
                    {
                        <div class="form-group">
                            <label>Calidad</label>
                            <select @bind="_imageQuality">
                                @foreach (var (value, label) in AiModuleOptions.GetImageQualitiesForModel(_model))
                                {
                                    <option value="@value">@label</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                @if (IsGptImage())
                {
                    <div class="form-group">
                        <label>Numero de imagenes <span class="text-sm text-muted">(1-4)</span></label>
                        <input type="number" min="1" max="4" @bind="_imageCount" />
                    </div>
                }
            }
            else if (_moduleType == "Video")
            {
                <div class="form-group">
                    <label>Movimiento por defecto <span class="text-sm text-muted">(se antepone a lo que llegue por el puerto)</span></label>
                    <textarea @bind="_videoPrompt" rows="3" placeholder="Ej: Camara con un lento zoom de acercamiento, movimiento suave, sin cortes..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Resolucion</label>
                        <select @bind="_videoResolution">
                            <option value="RESOLUTION_480">480p</option>
                            <option value="RESOLUTION_720">720p</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Interpolacion de fotogramas</label>
                        <select @bind="_videoFrameInterpolation">
                            <option value="true">Si (movimiento mas fluido)</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                </div>
                <span class="text-sm text-muted">
                    Se genera un clip por imagen conectada. Motion 2.0 entrega clips de 5 s sin audio.
                </span>
            }
            else if (_moduleType == "Image" && _provider == "LeonardoAI")
            {
                <div class="form-group">
                    <label>Instrucciones <span class="text-sm text-muted">(se añaden al inicio del prompt)</span></label>
                    <textarea @bind="_systemPrompt" rows="3" placeholder="Ej: Siempre usa un estilo fotorrealista, colores vibrantes y fondo neutro..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Ancho</label>
                        <select @bind="_leoWidth">
                            <option value="512">512</option>
                            <option value="768">768</option>
                            <option value="1024">1024</option>
                            <option value="1360">1360</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Alto</label>
                        <select @bind="_leoHeight">
                            <option value="512">512</option>
                            <option value="768">768</option>
                            <option value="1024">1024</option>
                            <option value="1360">1360</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Estilo</label>
                    <select @bind="_leoPresetStyle">
                        <option value="DYNAMIC">Dynamic</option>
                        <option value="NONE">Ninguno</option>
                        <option value="ANIME">Anime</option>
                        <option value="CINEMATIC">Cinematico</option>
                        <option value="PHOTOGRAPHY">Fotografia</option>
                        <option value="ILLUSTRATION">Ilustracion</option>
                        <option value="RAYTRACED">Raytraced</option>
                    </select>
                </div>
            }
            else if (_moduleType == "Image" && _provider == "Google")
            {
                <div class="form-group">
                    <label>Instrucciones <span class="text-sm text-muted">(se añaden al inicio del prompt)</span></label>
                    <textarea @bind="_systemPrompt" rows="3" placeholder="Ej: Siempre usa un estilo fotorrealista, colores vibrantes y fondo neutro..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Relacion de aspecto</label>
                        <select @bind="_geminiAspectRatio">
                            <option value="1:1">1:1 (Cuadrado)</option>
                            <option value="16:9">16:9 (Paisaje)</option>
                            <option value="9:16">9:16 (Retrato)</option>
                            <option value="4:3">4:3 (Clasico)</option>
                            <option value="3:4">3:4 (Retrato clasico)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Numero de imagenes <span class="text-sm text-muted">(1-4)</span></label>
                        <input type="number" min="1" max="4" @bind="_geminiImageCount" />
                    </div>
                </div>
            }
            else if (_moduleType == "Image" && _provider == "xAI")
            {
                <div class="form-group">
                    <label>Instrucciones <span class="text-sm text-muted">(se añaden al inicio del prompt)</span></label>
                    <textarea @bind="_systemPrompt" rows="3" placeholder="Ej: Siempre usa un estilo fotorrealista, colores vibrantes y fondo neutro..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Numero de imagenes <span class="text-sm text-muted">(1-4)</span></label>
                        <input type="number" min="1" max="4" @bind="_grokImageCount" />
                    </div>
                </div>
            }
            else if (_moduleType == "Design" && _provider == "Canva")
            {
                <div class="form-group">
                    <label>Access Token <span class="text-sm text-muted">(OAuth token de Canva Connect API)</span></label>
                    <input type="password" @bind="_canvaAccessToken" placeholder="Token OAuth de Canva" />
                </div>
                <div class="form-group">
                    <label>Formato de exportacion</label>
                    <select @bind="_canvaExportFormat">
                        <option value="png">PNG (imagen)</option>
                        <option value="jpg">JPG (imagen)</option>
                        <option value="pdf">PDF (documento)</option>
                        <option value="pptx">PPTX (presentacion)</option>
                    </select>
                </div>
                @if (_model == "canva-autofill")
                {
                    <div class="form-group">
                        <label>Brand Template ID <span class="text-sm text-muted">(opcional, se puede sobreescribir desde el paso del pipeline)</span></label>
                        <input type="text" @bind="_canvaBrandTemplate" placeholder="Ej: DAVZr1z5464..." />
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Tipo de diseno</label>
                        <select @bind="_canvaDesignType">
                            <option value="doc">Documento</option>
                            <option value="presentation">Presentacion</option>
                            <option value="whiteboard">Pizarra</option>
                        </select>
                    </div>
                }
            }
            else if (_moduleType == SearchConsoleConfig.ModuleType)
            {
                <SearchConsoleConfigEditor Config="_searchConsole" ApiKeyId="@(Guid.TryParse(_apiKeyId, out var scKey) ? scKey : null)" />
            }
            else if (_moduleType == "StaticText")
            {
                <div class="form-group">
                    <label>Contenido de texto</label>
                    <textarea @bind="_staticTextContent" rows="5" placeholder="Escribe aqui el texto que este modulo emitira como salida..."></textarea>
                    <p class="text-sm text-muted" style="margin-top: 0.15rem;">Este texto se usara tal cual como salida del modulo en cada ejecucion.</p>
                </div>
            }
            else if (_moduleType == "Embeddings")
            {
                <div class="form-group">
                    <label>Dimensiones <span class="text-sm text-muted">(opcional, por defecto la maxima del modelo)</span></label>
                    <input type="number" min="1" @bind="_embeddingDimensions" />
                </div>
            }
            else if (_moduleType == "Audio" && _provider == "OpenAI")
            {
                <div class="form-row">
                    <div class="form-group">
                        <label>Voz</label>
                        <select @bind="_ttsVoice">
                            @foreach (var (value, label) in AiModuleOptions.TtsVoices)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Velocidad <span class="text-sm text-muted">(0.25 - 4.0)</span></label>
                        <input type="number" step="0.25" min="0.25" max="4.0" @bind="_ttsSpeed" />
                    </div>
                </div>
                @if (AiModuleOptions.SupportsVoiceInstructions(_model))
                {
                    <div class="form-group">
                        <label>Instrucciones de voz <span class="text-sm text-muted">(tono, acento, ritmo)</span></label>
                        <textarea rows="2" @bind="_ttsInstructions" placeholder="Voz en off de anuncio, calida y cercana, acento de Espana."></textarea>
                    </div>
                }
            }
            else if (_moduleType == "Transcription" && _provider == "OpenAI")
            {
                <div class="form-row">
                    <div class="form-group">
                        <label>Idioma <span class="text-sm text-muted">(codigo ISO 639-1, opcional)</span></label>
                        <input type="text" @bind="_transcriptionLang" placeholder="es, en, fr..." />
                    </div>
                    <div class="form-group">
                        <label>Formato de respuesta</label>
                        <select @bind="_transcriptionFormat">
                            <option value="json">JSON</option>
                            <option value="text">Texto plano</option>
                            <option value="srt">SRT</option>
                            <option value="vtt">VTT</option>
                            <option value="verbose_json">JSON detallado</option>
                        </select>
                    </div>
                </div>
            }
        </fieldset>

        @if (_moduleType == "FileUpload")
        {
            <div class="form-group">
                <p class="text-sm text-muted">
                    Los archivos no se cargan en el catalogo. Cada instancia del modulo
                    dentro de un proyecto guarda sus propios archivos: subelos desde el
                    editor del proyecto.
                </p>
            </div>
        }

                            </div>
                        </div>
                        break;
                }
            </div>

            <div class="wizard-footer">
                @if (_wizardStep > 1)
                {
                    <button class="btn btn-secondary" @onclick="() => _wizardStep--"><i class="bi bi-arrow-left"></i> Atrás</button>
                }
                <span class="wizard-footer-spacer"></span>
                <span class="wizard-footer-step">Paso @_wizardStep de 4</span>
                @if (_wizardStep == 3)
                {
                    <button class="btn btn-primary" disabled="@string.IsNullOrEmpty(_model)" @onclick="GoToSummary">
                        Continuar <i class="bi bi-arrow-right"></i>
                    </button>
                }
                else if (_wizardStep == 4)
                {
                    <button class="btn btn-primary" @onclick="Create" disabled="@_loading">
                        <i class="bi bi-check2-circle"></i> @(_loading ? "Creando..." : "Crear módulo")
                    </button>
                }
            </div>
        </div>
    </div>
}

@* Editor de un modulo ya creado: General (nombre, descripcion, API key), Modelo
   (mismas tarjetas con estadisticas que el asistente de alta) y Configuracion
   (campos propios del tipo). Todo se guarda de una vez con "Guardar cambios". *@
@if (EditingModule is { } em)
{
    // Copia con el modelo y la clave pendientes: los campos de configuracion se
    // adaptan al modelo elegido aunque todavia no se haya guardado.
    var m = em with { ModelName = _editModel, ApiKeyId = Guid.TryParse(_editApiKeyId, out var pk) ? pk : null };
    var dirty = IsEditDirty(em);
    <div class="modal-overlay" @onclick="CloseEditor">
        <div class="modal-content module-wizard module-editor" @onclick:stopPropagation="true">
            <div class="wizard-header">
                <div class="settings-modal-title">
                    <span class="module-editor-logo"><ProviderIcon Provider="@em.ProviderType" Size="24" /></span>
                    <div>
                        <h3>@(string.IsNullOrWhiteSpace(_editName) ? em.Name : _editName)</h3>
                        <p>@TypeMetaFor(em.ModuleType).Label · @ProviderLabel(em.ProviderType) · <span class="module-editor-model">@(AllModels.FirstOrDefault(x => x.Id == _editModel)?.DisplayName ?? _editModel)</span></p>
                    </div>
                </div>
                <button class="btn-icon" title="Cerrar" @onclick="CloseEditor"><i class="bi bi-x-lg"></i></button>
            </div>

            @if (_editUsage is { ProjectCount: > 0 })
            {
                <div class="module-editor-usage">
                    <i class="bi bi-diagram-3"></i>
                    <span>
                        Se usa en <strong>@_editUsage.ProjectCount @(_editUsage.ProjectCount == 1 ? "pipeline" : "pipelines")</strong>:
                        @string.Join(", ", _editUsage.ProjectNames.Take(4))@(_editUsage.ProjectNames.Count > 4 ? $" y {_editUsage.ProjectNames.Count - 4} más" : "").
                        Los cambios se aplican en todos.
                    </span>
                </div>
            }

            <div class="pipeline-settings-layout module-editor-layout">
                <nav class="settings-nav" aria-label="Secciones del modulo">
                    <button class="settings-nav-item @(_editTab == "general" ? "is-active" : "")" @onclick='() => _editTab = "general"'>
                        <span class="settings-nav-icon" style="--tone:#8b83ff"><i class="bi bi-card-text"></i></span>
                        <span class="settings-nav-text"><strong>General</strong><small>Nombre, descripcion y API key</small></span>
                    </button>
                    @if (em.ProviderType != "System")
                    {
                        <button class="settings-nav-item @(_editTab == "model" ? "is-active" : "")" @onclick='() => _editTab = "model"'>
                            <span class="settings-nav-icon" style="--tone:#22d3ee"><i class="bi bi-cpu"></i></span>
                            <span class="settings-nav-text"><strong>Modelo</strong><small>Cambia el modelo del modulo</small></span>
                        </button>
                    }
                    <button class="settings-nav-item @(_editTab == "config" ? "is-active" : "")" @onclick='() => _editTab = "config"'>
                        <span class="settings-nav-icon" style="--tone:#f59e0b"><i class="bi bi-sliders"></i></span>
                        <span class="settings-nav-text"><strong>Configuracion</strong><small>Prompt y parametros</small></span>
                    </button>
                </nav>

                <div class="settings-modal-body">
                    @if (_editConfigError is not null)
                    {
                        <div class="alert alert-error">@_editConfigError</div>
                    }

                    @switch (_editTab)
                    {
                        case "model":
                            var candidates = ModelsFor(em.ProviderType, em.ModuleType);
                            var stats = ComputeStats(candidates);
                            @if (candidates.Count == 0)
                            {
                                <p class="text-muted">No hay otros modelos disponibles para este tipo de modulo.</p>
                            }
                            else
                            {
                                <div class="wizard-models">
                                    @foreach (var mi in candidates)
                                    {
                                        var st = stats[mi.Id];
                                        var lc = GetLifecycle(mi.Id);
                                        <button class="wizard-model @(_editModel == mi.Id ? "is-selected" : "") @(lc?.Status == "retired" ? "is-retired" : "")"
                                                @onclick="() => SelectEditModel(mi.Id)">
                                            @if (mi.Id == em.ModelName)
                                            {
                                                <span class="wizard-model-ribbon is-current"><i class="bi bi-bookmark-fill"></i> Actual</span>
                                            }
                                            else if (mi.Description.Contains("Recomendado", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="wizard-model-ribbon"><i class="bi bi-star-fill"></i> Recomendado</span>
                                            }
                                            <span class="wizard-model-head">
                                                <span class="wizard-model-avatar"><ProviderIcon Provider="@mi.Provider" Size="22" /></span>
                                                <span class="wizard-model-name">
                                                    <strong>@mi.DisplayName</strong>
                                                    <small>@mi.Id</small>
                                                </span>
                                                @if (_editModel == mi.Id)
                                                {
                                                    <span class="wizard-model-check"><i class="bi bi-check-lg"></i></span>
                                                }
                                            </span>
                                            <span class="wizard-model-desc">@mi.Description</span>
                                            <span class="wizard-stats">
                                                @foreach (var stat in st.Bars)
                                                {
                                                    <span class="wizard-stat">
                                                        <span class="wizard-stat-label"><i class="bi @stat.Icon"></i> @stat.Label</span>
                                                        <span class="wizard-stat-track"><span class="wizard-stat-fill" style="--w:@(stat.Percent)%; --tone:@stat.Tone"></span></span>
                                                        <span class="wizard-stat-value">@stat.Value</span>
                                                    </span>
                                                }
                                            </span>
                                            <span class="wizard-model-caps">
                                                @foreach (var cap in mi.Capabilities)
                                                {
                                                    <span class="cap-chip">@CapLabelEs(cap)</span>
                                                }
                                                <ModelLifecycleBadge Info="@lc" Compact="true" />
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                            break;

                        case "config":
                            <div class="module-editor-section">
                    @if (m.ModuleType is "Text" or "Coordinator" or "Orchestrator")
                    {
                        <div class="form-group">
                            <label>System Prompt</label>
                            <textarea @bind="_editSystemPrompt" rows="4" placeholder="@(m.ModuleType == "Coordinator" ? "Ej: Recibiras datos de varias entradas. Genera un JSON array de recursos..." : m.ModuleType == "Orchestrator" ? "Ej: Prioriza videos de stock sobre generacion. Maximo 5 tareas por plan." : "Ej: Eres un asistente experto en...")"></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Temperatura <span class="text-sm text-muted">(0.0 - 2.0)</span></label>
                                <input type="number" step="0.1" min="0" max="2" @bind="_editTemperature" />
                            </div>
                            <div class="form-group">
                                <label>Max Tokens</label>
                                <input type="number" min="1" max="200000" @bind="_editMaxTokens" />
                            </div>
                        </div>
                        @if (AiModuleOptions.SupportsWebSearch(m.ProviderType, m.ModuleType))
                        {
                            <div class="form-group">
                                <label class="form-check">
                                    <input type="checkbox" @bind="_editWebSearch" />
                                    Busqueda en internet
                                    <span class="text-sm text-muted">(puede buscar y leer paginas web; cada busqueda tiene coste)</span>
                                </label>
                            </div>
                        }
                        @if (AiModuleOptions.SupportsReasoningEffort(m.ProviderType, m.ModelName))
                        {
                            <div class="form-group">
                                <label>
                                    Esfuerzo de razonamiento
                                    <span class="text-sm text-muted">(los tokens de razonamiento se facturan como salida)</span>
                                </label>
                                <select @bind="_editReasoningEffort">
                                    @foreach (var (value, label) in AiModuleOptions.ReasoningEffortOptions)
                                    {
                                        <option value="@value">@label</option>
                                    }
                                </select>
                            </div>
                        }
                    }
                    else if (m.ModuleType == "Image" && m.ProviderType == "OpenAI")
                    {
                        <div class="form-group">
                            <label>Instrucciones <span class="text-sm text-muted">(se añaden al inicio del prompt)</span></label>
                            <textarea @bind="_editSystemPrompt" rows="3" placeholder="Ej: Siempre usa un estilo fotorrealista, colores vibrantes y fondo neutro..."></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Tamano</label>
                                <select @bind="_editImageSize">
                                    @foreach (var s in GetImageSizesForModel(m.ModelName))
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>
                            @if (AiModuleOptions.SupportsQuality(m.ModelName))
                            {
                                <div class="form-group">
                                    <label>Calidad</label>
                                    <select @bind="_editImageQuality">
                                        @foreach (var (value, label) in AiModuleOptions.GetImageQualitiesForModel(m.ModelName))
                                        {
                                            <option value="@value">@label</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    }
                    else if (m.ModuleType == "Image" && m.ProviderType == "Google")
                    {
                        <div class="form-group">
                            <label>Instrucciones <span class="text-sm text-muted">(se añaden al inicio del prompt)</span></label>
                            <textarea @bind="_editSystemPrompt" rows="3" placeholder="Ej: Siempre usa un estilo fotorrealista, colores vibrantes y fondo neutro..."></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Relacion de aspecto</label>
                                <select @bind="_editGeminiAspectRatio">
                                    <option value="1:1">1:1 (Cuadrado)</option>
                                    <option value="16:9">16:9 (Paisaje)</option>
                                    <option value="9:16">9:16 (Retrato)</option>
                                    <option value="4:3">4:3 (Clasico)</option>
                                    <option value="3:4">3:4 (Retrato clasico)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Numero de imagenes <span class="text-sm text-muted">(1-4)</span></label>
                                <input type="number" min="1" max="4" @bind="_editGeminiImageCount" />
                            </div>
                        </div>
                    }
                    else if (m.ModuleType == "Image" && m.ProviderType == "xAI")
                    {
                        <div class="form-group">
                            <label>Instrucciones <span class="text-sm text-muted">(se añaden al inicio del prompt)</span></label>
                            <textarea @bind="_editSystemPrompt" rows="3" placeholder="Ej: Siempre usa un estilo fotorrealista, colores vibrantes y fondo neutro..."></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Numero de imagenes <span class="text-sm text-muted">(1-4)</span></label>
                                <input type="number" min="1" max="4" @bind="_editGrokImageCount" />
                            </div>
                        </div>
                    }
                    else if (m.ModuleType == "Video")
                    {
                        <div class="form-group">
                            <label>Movimiento por defecto <span class="text-sm text-muted">(se antepone a lo que llegue por el puerto)</span></label>
                            <textarea @bind="_editVideoPrompt" rows="3" placeholder="Ej: Camara con un lento zoom de acercamiento, movimiento suave, sin cortes..."></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Resolucion</label>
                                <select @bind="_editVideoResolution">
                                    <option value="RESOLUTION_480">480p</option>
                                    <option value="RESOLUTION_720">720p</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Interpolacion de fotogramas</label>
                                <select @bind="_editVideoFrameInterpolation">
                                    <option value="true">Si (movimiento mas fluido)</option>
                                    <option value="false">No</option>
                                </select>
                            </div>
                        </div>
                    }
                    else if (m.ModuleType == "Image" && m.ProviderType == "LeonardoAI")
                    {
                        <div class="form-group">
                            <label>Instrucciones <span class="text-sm text-muted">(se añaden al inicio del prompt)</span></label>
                            <textarea @bind="_editSystemPrompt" rows="3" placeholder="Ej: Siempre usa un estilo fotorrealista, colores vibrantes y fondo neutro..."></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Ancho</label>
                                <select @bind="_editLeoWidth">
                                    <option value="512">512</option>
                                    <option value="768">768</option>
                                    <option value="1024">1024</option>
                                    <option value="1360">1360</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Alto</label>
                                <select @bind="_editLeoHeight">
                                    <option value="512">512</option>
                                    <option value="768">768</option>
                                    <option value="1024">1024</option>
                                    <option value="1360">1360</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Estilo</label>
                            <select @bind="_editLeoPresetStyle">
                                <option value="DYNAMIC">Dynamic</option>
                                <option value="NONE">Ninguno</option>
                                <option value="ANIME">Anime</option>
                                <option value="CINEMATIC">Cinematico</option>
                                <option value="PHOTOGRAPHY">Fotografia</option>
                                <option value="ILLUSTRATION">Ilustracion</option>
                                <option value="RAYTRACED">Raytraced</option>
                            </select>
                        </div>
                    }
                    else if (m.ModuleType == "Audio" && m.ProviderType == "OpenAI")
                    {
                        <div class="form-row">
                            <div class="form-group">
                                <label>Voz</label>
                                <select @bind="_editTtsVoice">
                                    @foreach (var (value, label) in AiModuleOptions.TtsVoices)
                                    {
                                        <option value="@value">@label</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Velocidad <span class="text-sm text-muted">(0.25 - 4.0)</span></label>
                                <input type="number" step="0.25" min="0.25" max="4.0" @bind="_editTtsSpeed" />
                            </div>
                        </div>
                        @if (AiModuleOptions.SupportsVoiceInstructions(m.ModelName))
                        {
                            <div class="form-group">
                                <label>Instrucciones de voz <span class="text-sm text-muted">(tono, acento, ritmo)</span></label>
                                <textarea rows="2" @bind="_editTtsInstructions" placeholder="Voz en off de anuncio, calida y cercana, acento de Espana."></textarea>
                            </div>
                        }
                    }
                    else if (m.ModuleType == "Design" && m.ProviderType == "Canva")
                    {
                        <div class="form-group">
                            <label>Access Token</label>
                            <input type="password" @bind="_editCanvaAccessToken" placeholder="Token OAuth de Canva" />
                        </div>
                        <div class="form-group">
                            <label>Formato de exportacion</label>
                            <select @bind="_editCanvaExportFormat">
                                <option value="png">PNG (imagen)</option>
                                <option value="jpg">JPG (imagen)</option>
                                <option value="pdf">PDF (documento)</option>
                                <option value="pptx">PPTX (presentacion)</option>
                            </select>
                        </div>
                        @if (m.ModelName == "canva-autofill")
                        {
                            <div class="form-group">
                                <label>Brand Template ID</label>
                                <input type="text" @bind="_editCanvaBrandTemplate" placeholder="Ej: DAVZr1z5464..." />
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label>Tipo de diseno</label>
                                <select @bind="_editCanvaDesignType">
                                    <option value="doc">Documento</option>
                                    <option value="presentation">Presentacion</option>
                                    <option value="whiteboard">Pizarra</option>
                                </select>
                            </div>
                        }
                    }
                    else if (m.ModuleType == SearchConsoleConfig.ModuleType)
                    {
                        <SearchConsoleConfigEditor Config="_editSearchConsole" ApiKeyId="m.ApiKeyId" />
                    }
                    else if (m.ModuleType == "StaticText")
                    {
                        <div class="form-group">
                            <label>Contenido de texto</label>
                            <textarea @bind="_editStaticTextContent" rows="5" placeholder="Texto que este modulo emitira como salida..."></textarea>
                            <p class="text-sm text-muted" style="margin-top: 0.15rem;">Este texto se usara tal cual como salida del modulo.</p>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Este tipo de modulo no tiene configuracion editable.</p>
                    }

                            </div>
                            break;

                        default:
                            <div class="module-editor-section">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Nombre del modulo</label>
                                        <input type="text" @bind="_editName" @bind:event="oninput" />
                                    </div>
                                    <div class="form-group">
                                        <label>Descripcion</label>
                                        <input type="text" @bind="_editDesc" @bind:event="oninput" placeholder="Descripcion opcional" />
                                    </div>
                                </div>
                                @if (em.ProviderType != "System")
                                {
                                    var provKeys = _keys.Where(k => k.ProviderType.Equals(em.ProviderType, StringComparison.OrdinalIgnoreCase)).ToList();
                                    <div class="form-group">
                                        <label>API Key (@ProviderLabel(em.ProviderType))</label>
                                        <select @bind="_editApiKeyId">
                                            <option value="">-- Sin API Key --</option>
                                            @foreach (var k in provKeys)
                                            {
                                                <option value="@k.Id">@k.Name</option>
                                            }
                                        </select>
                                        @if (provKeys.Count == 0)
                                        {
                                            <span class="text-sm text-muted">No tienes API keys de @ProviderLabel(em.ProviderType). <a class="link" href="/configuracion/apikeys">Crear una</a></span>
                                        }
                                        else if (string.IsNullOrEmpty(_editApiKeyId))
                                        {
                                            <span class="module-warning"><i class="bi bi-exclamation-triangle-fill"></i> Sin API key el modulo no puede ejecutarse</span>
                                        }
                                    </div>
                                }
                                <div class="module-editor-facts">
                                    <div><span>Proveedor</span><strong><ProviderIcon Provider="@em.ProviderType" Size="13" /> @ProviderLabel(em.ProviderType)</strong></div>
                                    <div><span>Tipo</span><strong><i class="bi @TypeMetaFor(em.ModuleType).Icon"></i> @TypeMetaFor(em.ModuleType).Label</strong></div>
                                    <div><span>Creado</span><strong>@em.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                                    <div><span>Ultimo cambio</span><strong>@em.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong></div>
                                </div>
                                <p class="text-sm text-muted">El proveedor y el tipo no se pueden cambiar: si necesitas otro, crea un modulo nuevo.</p>
                            </div>
                            break;
                    }
                </div>
            </div>

            <div class="wizard-footer">
                @if (_editConfigSuccess && !dirty)
                {
                    <span class="module-editor-saved"><i class="bi bi-check2-circle"></i> Cambios guardados</span>
                }
                else if (dirty)
                {
                    <span class="module-editor-dirty"><i class="bi bi-circle-fill"></i> Cambios sin guardar</span>
                }
                <span class="wizard-footer-spacer"></span>
                <button class="btn btn-secondary" @onclick="CloseEditor">@(dirty ? "Descartar" : "Cerrar")</button>
                <button class="btn btn-primary" @onclick="SaveModuleEdits" disabled="@(_editConfigSaving || !dirty)">
                    <i class="bi bi-check2"></i> @(_editConfigSaving ? "Guardando..." : "Guardar cambios")
                </button>
            </div>
        </div>
    </div>
}

@if (!_loaded)
{
    @* El esqueleto ya se pinta arriba; aqui no va nada hasta tener los datos. *@
}
else if (UserModules.Count > 0)
{
    var _groups = GetModuleGroups();
    if (_groups.Count == 0 && (!string.IsNullOrWhiteSpace(_search) || _providerFilter is not null))
    {
        @* Sin coincidencias para la búsqueda o el filtro actual *@
        <div class="empty-hero is-compact">
            <div class="empty-hero-icon"><i class="bi bi-search"></i></div>
            <h3>Sin resultados</h3>
            <p>No hay módulos que coincidan con la búsqueda o el filtro.</p>
            <button class="btn btn-secondary" @onclick="ClearSearch">Limpiar filtros</button>
        </div>
    }
    @foreach (var group in _groups)
    {
        <div class="module-group" data-type="@group.Type">
            <div class="module-group-header">
                <span class="module-group-icon"><i class="bi @group.Icon"></i></span>
                <h3 class="module-group-title">@group.Label</h3>
                <span class="projects-section-count module-group-count">@group.Modules.Count</span>
            </div>
            <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Proveedor</th>
                        <th>Modelo</th>
                        <th>API Key</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in group.Modules)
                    {
                <tr class="@(_editingModuleId == m.Id ? "is-editing" : "")">
                    <td>
                        <span class="module-name">@m.Name</span>
                        @if (NeedsKey(m))
                        {
                            <span class="module-warning" title="Sin API key no se puede ejecutar"><i class="bi bi-exclamation-triangle-fill"></i> Sin API key</span>
                        }
                    </td>
                    <td>
                        <span class="badge @GetModuleProviderBadgeClass(m.ProviderType)">
                            <ProviderIcon Provider="@m.ProviderType" Size="13" />&nbsp;@m.ProviderType
                        </span>
                    </td>
                    <td>
                        @if (m.ProviderType == "System")
                        {
                            <span class="text-muted">@m.ModelName</span>
                        }
                        else
                        {
                            <select class="select-inline"
                                    value="@m.ModelName"
                                    @onchange="(e) => ChangeModel(m, e)">
                                @foreach (var model in AllModels.Where(x => x.Provider == m.ProviderType && x.Types.Contains(m.ModuleType)))
                                {
                                    <option value="@model.Id">@model.DisplayName</option>
                                }
                            </select>
                            <ModelLifecycleBadge Info="@GetLifecycle(m.ModelName)" Compact="true" />
                        }
                    </td>
                    <td>
                        @if (m.ProviderType == "System")
                        {
                            <span class="text-muted">No aplica</span>
                        }
                        else
                        {
                            <select class="select-inline"
                                    value="@(m.ApiKeyId?.ToString() ?? "")"
                                    @onchange="(e) => ChangeApiKey(m, e)">
                                <option value="">-- Sin API Key --</option>
                                @foreach (var k in _keys.Where(k => k.ProviderType.Equals(m.ProviderType, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@k.Id">@k.Name</option>
                                }
                            </select>
                        }
                    </td>
                    <td class="cell-actions">
                        <button class="btn btn-sm btn-ghost" @onclick="() => ToggleEditConfig(m)"><i class="bi bi-sliders"></i> Configurar</button>
                        @if (IsBuiltInSystemModule(m))
                        {
                            <span class="text-muted" style="align-self: center; font-size: 0.8rem;">Integrado</span>
                        }
                        else
                        {
                            <button class="icon-btn icon-btn-danger" title="Eliminar" @onclick="() => Delete(m.Id)"><i class="bi bi-trash3"></i></button>
                        }
                    </td>
                </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
}
else
{
