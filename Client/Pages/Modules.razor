    // ── Build config JSON ──
    private string? BuildConfigJson()
    {
        if (_moduleType == SearchConsoleConfig.ModuleType)
            return _searchConsole.ToJson();

        var parts = new List<string>();

        if (_moduleType is "Text" or "Orchestrator" or "Coordinator")
        {
            if (!string.IsNullOrWhiteSpace(_systemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_systemPrompt)}");
            if (_temperature != 0.7)
                parts.Add($"\"temperature\":{_temperature}");
            if (_maxTokens != 4096)
                parts.Add($"\"maxTokens\":{_maxTokens}");
            if (AiModuleOptions.SupportsReasoningEffort(_provider, _model)
                && !string.IsNullOrWhiteSpace(_reasoningEffort))
                parts.Add($"\"reasoningEffort\":\"{_reasoningEffort}\"");
            // Se escribe siempre, tambien en false: un modulo sin la clave es uno
            // anterior a la opcion y el servidor lo trata como desactivado.
            if (AiModuleOptions.SupportsWebSearch(_provider, _moduleType))
                parts.Add($"\"webSearch\":{(_webSearch ? "true" : "false")}");
        }
        else if (_moduleType == "Image" && _provider == "Google")
        {
            if (!string.IsNullOrWhiteSpace(_systemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_systemPrompt)}");
            if (_geminiAspectRatio != "1:1")
                parts.Add($"\"aspectRatio\":\"{_geminiAspectRatio}\"");
            if (_geminiImageCount != 1)
                parts.Add($"\"numberOfImages\":{_geminiImageCount}");
        }
        else if (_moduleType == "Image" && _provider == "xAI")
        {
            if (!string.IsNullOrWhiteSpace(_systemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_systemPrompt)}");
            if (_grokImageCount != 1)
                parts.Add($"\"n\":{_grokImageCount}");
        }
        else if (_moduleType == "Video")
        {
            if (!string.IsNullOrWhiteSpace(_videoPrompt))
                parts.Add($"\"videoPrompt\":{System.Text.Json.JsonSerializer.Serialize(_videoPrompt)}");
            if (_videoResolution != "RESOLUTION_480")
                parts.Add($"\"resolution\":\"{_videoResolution}\"");
            if (_videoFrameInterpolation != "true")
                parts.Add($"\"frameInterpolation\":{_videoFrameInterpolation}");
        }
        else if (_moduleType == "Image" && _provider == "LeonardoAI")
        {
            if (!string.IsNullOrWhiteSpace(_systemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_systemPrompt)}");
            if (_leoWidth != 1024)
                parts.Add($"\"width\":{_leoWidth}");
            if (_leoHeight != 1024)
                parts.Add($"\"height\":{_leoHeight}");
            if (_leoPresetStyle != "DYNAMIC")
                parts.Add($"\"presetStyle\":\"{_leoPresetStyle}\"");
        }
        else if (_moduleType == "Image")
        {
            if (!string.IsNullOrWhiteSpace(_systemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_systemPrompt)}");
            if (_imageSize != "1024x1024")
                parts.Add($"\"size\":\"{_imageSize}\"");
            // La calidad se escribe siempre: si se omite, la API aplica "auto",
            // que en gpt-image resuelve al tramo mas caro (high).
            if (_provider == "OpenAI" && AiModuleOptions.SupportsQuality(_model))
                parts.Add($"\"quality\":\"{_imageQuality}\"");
            if (IsGptImage() && _imageCount != 1)
                parts.Add($"\"n\":{_imageCount}");
        }
        else if (_moduleType == "StaticText")
        {
            if (!string.IsNullOrWhiteSpace(_staticTextContent))
                parts.Add($"\"content\":{System.Text.Json.JsonSerializer.Serialize(_staticTextContent)}");
        }
        else if (_moduleType == "Embeddings")
        {
            if (_embeddingDimensions.HasValue)
                parts.Add($"\"dimensions\":{_embeddingDimensions.Value}");
        }
        else if (_moduleType == "Audio")
        {
            parts.Add($"\"voice\":\"{_ttsVoice}\"");
            if (_ttsSpeed != 1.0)
                parts.Add($"\"speed\":{_ttsSpeed}");
            if (!string.IsNullOrWhiteSpace(_ttsInstructions))
                parts.Add($"\"voiceInstructions\":{System.Text.Json.JsonSerializer.Serialize(_ttsInstructions)}");
        }
        else if (_moduleType == "Transcription")
        {
            if (!string.IsNullOrWhiteSpace(_transcriptionLang))
                parts.Add($"\"language\":\"{_transcriptionLang}\"");
            if (_transcriptionFormat != "json")
                parts.Add($"\"response_format\":\"{_transcriptionFormat}\"");
        }
        else if (_moduleType == "Design" && _provider == "Canva")
        {
            if (!string.IsNullOrWhiteSpace(_canvaAccessToken))
                parts.Add($"\"accessToken\":{System.Text.Json.JsonSerializer.Serialize(_canvaAccessToken)}");
            if (_canvaExportFormat != "png")
                parts.Add($"\"exportFormat\":\"{_canvaExportFormat}\"");
            if (!string.IsNullOrWhiteSpace(_canvaBrandTemplate))
                parts.Add($"\"brandTemplateId\":{System.Text.Json.JsonSerializer.Serialize(_canvaBrandTemplate)}");
            if (_canvaDesignType != "doc")
                parts.Add($"\"designType\":\"{_canvaDesignType}\"");
        }
        return parts.Count > 0 ? "{" + string.Join(",", parts) + "}" : null;
    }

    // ── Lifecycle ──

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _modules = await Api.GetModulesAsync();
            _keys = await Api.GetApiKeysAsync();
        }
        catch { }
        _loading = false;
        _loaded = true;

        // Despues de pintar: consultar el estado de los modelos implica llamar al
        // proveedor, y no merece retrasar la pantalla por unas etiquetas de aviso.
        await LoadLifecycleAsync();
    }

    // ── Ciclo de vida de modelos ──

    private Dictionary<string, ModelLifecycleResponse> _lifecycle = new(StringComparer.OrdinalIgnoreCase);

    private ModelLifecycleResponse? GetLifecycle(string? modelId) =>
        !string.IsNullOrWhiteSpace(modelId) && _lifecycle.TryGetValue(modelId!, out var lc) ? lc : null;

    private async Task LoadLifecycleAsync()
    {
        try
        {
            var entries = await Api.GetModelLifecycleAsync();
            _lifecycle = entries.ToDictionary(e => e.Id, StringComparer.OrdinalIgnoreCase);
            StateHasChanged();
        }
        catch { }
    }

    private async Task Create()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_provider)) { _error = "Selecciona un proveedor"; return; }
        if (string.IsNullOrWhiteSpace(_moduleType)) { _error = "Selecciona un tipo de modulo"; return; }
        if (string.IsNullOrWhiteSpace(_model)) { _error = "Selecciona un modelo"; return; }
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Indica un nombre para el modulo"; return; }
        if (_moduleType == SearchConsoleConfig.ModuleType)
        {
            if (string.IsNullOrWhiteSpace(_apiKeyId)) { _error = "Selecciona la API key de Search Console (cuenta de servicio)"; return; }
            if (string.IsNullOrWhiteSpace(_searchConsole.SiteUrl)) { _error = "Indica la propiedad de Search Console"; return; }
        }

        _loading = true;
        try
        {
            Guid? keyId = Guid.TryParse(_apiKeyId, out var id) ? id : null;
            var config = BuildConfigJson();
            var req = new CreateAiModuleRequest(_name, _desc, _provider, _moduleType, _model, keyId, config);
            var (ok, error, moduleId) = await Api.CreateModuleAsync(req);
            if (ok)
            {
                // Los archivos del modulo se cargan en cada ProjectModule del proyecto,
                // no aqui en el catalogo. Si el usuario marca archivos en la pantalla
                // de creacion (caso legacy) los descartamos en silencio.
                _createPendingFiles.Clear();
                _name = ""; _desc = ""; _model = ""; _apiKeyId = "";
                ResetConfig();
                _modules = await Api.GetModulesAsync();
                // Cierre automático del modal tras creación exitosa: la lista se refresca antes de cerrar
                // para que el nuevo módulo aparezca inmediatamente al volver a la vista principal.
                _showCreateModal = false;
            }
            else _error = error;
        }
        catch (Exception ex) { _error = $"Error de conexion: {ex.Message}"; }
        _loading = false;
    }

    private async Task ChangeModel(AiModuleResponse module, ChangeEventArgs e)
    {
        var newModel = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(newModel) || newModel == module.ModelName) return;

        try
        {
            var (ok, error) = await Api.UpdateModuleModelAsync(module.Id, module, newModel);
            if (ok)
                _modules = await Api.GetModulesAsync();
            else
                _error = error;
        }
        catch (Exception ex) { _error = $"Error al cambiar modelo: {ex.Message}"; }
    }

    private async Task ChangeApiKey(AiModuleResponse module, ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        Guid? newKeyId = Guid.TryParse(val, out var parsed) ? parsed : null;
        if (newKeyId == module.ApiKeyId) return;

        try
        {
            var (ok, error) = await Api.UpdateModuleApiKeyAsync(module.Id, module, newKeyId);
            if (ok)
                _modules = await Api.GetModulesAsync();
            else
                _error = error;
        }
        catch (Exception ex) { _error = $"Error al cambiar API Key: {ex.Message}"; }
    }

    private async Task ToggleEditConfig(AiModuleResponse module)
    {
        _editingModuleId = module.Id;
        _editConfigError = null;
        _editConfigSuccess = false;
        _editTab = "general";
        _editName = module.Name;
        _editDesc = module.Description ?? "";
        _editModel = module.ModelName;
        _editApiKeyId = module.ApiKeyId?.ToString() ?? "";
        _editUsage = null;

        // Parse existing configuration
        _editSystemPrompt = "";
        _editTemperature = 0.7;
        _editMaxTokens = 4096;
        _editImageSize = "1024x1024";
        _editImageQuality = AiModuleOptions.DefaultQualityForModel(module.ModelName);
        _editReasoningEffort = "";
        _editWebSearch = false;
        _editTtsVoice = "alloy";
        _editTtsSpeed = 1.0;
        _editTtsInstructions = "";
        _editLeoWidth = 1024;
        _editLeoHeight = 1024;
        _editLeoPresetStyle = "DYNAMIC";
        _editVideoPrompt = "";
        _editVideoResolution = "RESOLUTION_480";
        _editVideoFrameInterpolation = "true";
        _editCanvaAccessToken = "";
        _editCanvaExportFormat = "png";
        _editCanvaBrandTemplate = "";
        _editCanvaDesignType = "doc";
        _editGrokImageCount = 1;
        _editSearchConsole = SearchConsoleConfig.FromJson(module.Configuration);

        if (!string.IsNullOrWhiteSpace(module.Configuration))
        {
            try
            {
                var doc = System.Text.Json.JsonDocument.Parse(module.Configuration);
                var root = doc.RootElement;

                if (root.TryGetProperty("systemPrompt", out var sp)) _editSystemPrompt = sp.GetString() ?? "";
                if (root.TryGetProperty("temperature", out var t)) _editTemperature = t.GetDouble();
                if (root.TryGetProperty("maxTokens", out var mt)) _editMaxTokens = mt.GetInt32();
                if (root.TryGetProperty("size", out var sz)) _editImageSize = sz.GetString() ?? "1024x1024";
                if (root.TryGetProperty("quality", out var q))
                    _editImageQuality = AiModuleOptions.NormalizeQualityForModel(q.GetString(), module.ModelName);
                if (root.TryGetProperty("reasoningEffort", out var re)) _editReasoningEffort = re.GetString() ?? "";
                if (root.TryGetProperty("webSearch", out var ws)) _editWebSearch = ws.ValueKind == System.Text.Json.JsonValueKind.True;
                if (root.TryGetProperty("voice", out var v)) _editTtsVoice = v.GetString() ?? "alloy";
                if (root.TryGetProperty("speed", out var spd)) _editTtsSpeed = spd.GetDouble();
                if (root.TryGetProperty("voiceInstructions", out var vi)) _editTtsInstructions = vi.GetString() ?? "";
                if (root.TryGetProperty("width", out var lw)) _editLeoWidth = lw.GetInt32();
                if (root.TryGetProperty("height", out var lh)) _editLeoHeight = lh.GetInt32();
                if (root.TryGetProperty("presetStyle", out var lps)) _editLeoPresetStyle = lps.GetString() ?? "DYNAMIC";
                if (root.TryGetProperty("videoPrompt", out var vp)) _editVideoPrompt = vp.GetString() ?? "";
                if (root.TryGetProperty("resolution", out var vr)) _editVideoResolution = vr.GetString() ?? "RESOLUTION_480";
                if (root.TryGetProperty("frameInterpolation", out var vfi))
                    _editVideoFrameInterpolation = vfi.ValueKind == System.Text.Json.JsonValueKind.False ? "false" : "true";
                if (root.TryGetProperty("aspectRatio", out var ar)) _editGeminiAspectRatio = ar.GetString() ?? "1:1";
                if (root.TryGetProperty("numberOfImages", out var ni)) _editGeminiImageCount = ni.GetInt32();
                if (root.TryGetProperty("n", out var grokN)) _editGrokImageCount = grokN.GetInt32();
                if (root.TryGetProperty("accessToken", out var cat)) _editCanvaAccessToken = cat.GetString() ?? "";
                if (root.TryGetProperty("exportFormat", out var cef)) _editCanvaExportFormat = cef.GetString() ?? "png";
                if (root.TryGetProperty("brandTemplateId", out var cbt)) _editCanvaBrandTemplate = cbt.GetString() ?? "";
                if (root.TryGetProperty("designType", out var cdt)) _editCanvaDesignType = cdt.GetString() ?? "doc";
                // StaticText
                if (root.TryGetProperty("content", out var stContent)) _editStaticTextContent = stContent.GetString() ?? "";
            }
            catch { }
        }

        // Ya no se cargan archivos en el catalogo: viven en cada ProjectModule.
        _editModuleFiles = [];
        _fileUploadError = null;

        // Linea base para saber si hay cambios sin guardar: se compara con la
        // configuracion tal y como la reconstruye el propio editor.
        _editBaselineConfig = EditableConfig(module.ModuleType)
            ? BuildEditConfigJson(module.ModuleType, module.ProviderType, module.ModelName)
            : module.Configuration;

        StateHasChanged();
        try { _editUsage = await Api.GetModuleUsageAsync(module.Id); } catch { }
        if (_pricing.Count == 0)
        {
            try { _pricing = (await Api.GetModelPricingAsync()).ToDictionary(x => x.Id, StringComparer.OrdinalIgnoreCase); }
            catch { }
        }
    }

    // ── Editor de modulo existente ──
    private string _editTab = "general";
    private string _editName = "";
    private string _editDesc = "";
    private string _editModel = "";
    private string _editApiKeyId = "";
    private string? _editBaselineConfig;
    private ModuleUsageResponse? _editUsage;

    private AiModuleResponse? EditingModule =>
        _editingModuleId is { } id ? _modules.FirstOrDefault(x => x.Id == id) : null;

    private void CloseEditor()
    {
        _editingModuleId = null;
        _editConfigError = null;
        _editConfigSuccess = false;
    }

    private List<ModelInfo> ModelsFor(string provider, string type) =>
        AllModels.Where(x => x.Provider == provider && x.Types.Contains(type)).ToList();

    private void SelectEditModel(string modelId)
    {
        _editModel = modelId;
        // Mismo reencuadre que al crear: tamano y calidad validos para el modelo nuevo.
        var sizes = GetImageSizesForModel(modelId);
        if (!sizes.Contains(_editImageSize)) _editImageSize = sizes[0];
        _editImageQuality = AiModuleOptions.NormalizeQualityForModel(_editImageQuality, modelId);
        _editConfigSuccess = false;
    }

    /// <summary>
    /// Tipos cuya configuracion reconstruye el editor. En el resto se conserva tal
    /// cual la guardada, para no perder claves que el formulario no conoce.
    /// </summary>
    private static bool EditableConfig(string moduleType) =>
        moduleType is "Text" or "Orchestrator" or "Coordinator" or "Image" or "Video" or "Audio" or "Design"
            or "StaticText" or "SearchConsole";

    private string? PendingConfig(AiModuleResponse module) =>
        EditableConfig(module.ModuleType)
            ? BuildEditConfigJson(module.ModuleType, module.ProviderType, _editModel)
            : module.Configuration;

    private bool IsEditDirty(AiModuleResponse module) =>
        _editName != module.Name
        || _editDesc != (module.Description ?? "")
        || _editModel != module.ModelName
        || _editApiKeyId != (module.ApiKeyId?.ToString() ?? "")
        || PendingConfig(module) != _editBaselineConfig;

    private async Task SaveModuleEdits()
    {
        if (EditingModule is not { } module) return;
        _editConfigError = null;
        _editConfigSuccess = false;
        if (string.IsNullOrWhiteSpace(_editName)) { _editConfigError = "El nombre del modulo es obligatorio."; _editTab = "general"; return; }

        _editConfigSaving = true;
        try
        {
            var updated = module with
            {
                Name = _editName.Trim(),
                Description = string.IsNullOrWhiteSpace(_editDesc) ? null : _editDesc.Trim(),
                ModelName = _editModel,
                ApiKeyId = Guid.TryParse(_editApiKeyId, out var k) ? k : null,
                Configuration = PendingConfig(module),
            };
            var (ok, error) = await Api.UpdateModuleAsync(module.Id, updated);
            if (ok)
            {
                _modules = await Api.GetModulesAsync();
                _editBaselineConfig = PendingConfig(EditingModule ?? updated);
                _editConfigSuccess = true;
            }
            else _editConfigError = error;
        }
        catch (Exception ex) { _editConfigError = $"Error: {ex.Message}"; }
        _editConfigSaving = false;
    }

    private async Task OnModuleFilesSelected(InputFileChangeEventArgs e)
    {
        if (_editingModuleId is null) return;
        _fileUploadError = null;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            foreach (var file in e.GetMultipleFiles(10))
            {
                content.Add(CreateBrowserFileContent(file), "files", file.Name);
            }

            var uploaded = await Api.UploadModuleFilesAsync(_editingModuleId.Value, content);
            _editModuleFiles.InsertRange(0, uploaded);
        }
        catch (Exception ex) { _fileUploadError = $"Error al subir: {ex.Message}"; }
    }

    private void OnCreateFilesSelected(InputFileChangeEventArgs e)
    {
        _createPendingFiles.AddRange(e.GetMultipleFiles(10));
    }

    private static StreamContent CreateBrowserFileContent(IBrowserFile file)
    {
        var stream = file.OpenReadStream(maxAllowedSize: MaxUploadFileSize);
        var content = new StreamContent(stream);
        var contentType = string.IsNullOrWhiteSpace(file.ContentType)
            ? "application/octet-stream"
            : file.ContentType;
        content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);
        return content;
    }

    private async Task DeleteModuleFile(Guid fileId, Guid moduleId)
    {
        try
        {
            await Api.DeleteModuleFileAsync(fileId);
            _editModuleFiles.RemoveAll(f => f.Id == fileId);
        }
        catch { }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private string? BuildEditConfigJson(string moduleType, string providerType, string modelName)
    {
        if (moduleType == SearchConsoleConfig.ModuleType)
            return _editSearchConsole.ToJson();

        var parts = new List<string>();

        if (moduleType is "Text" or "Orchestrator" or "Coordinator")
        {
            if (!string.IsNullOrWhiteSpace(_editSystemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_editSystemPrompt)}");
            if (_editTemperature != 0.7)
                parts.Add($"\"temperature\":{_editTemperature}");
            if (_editMaxTokens != 4096)
                parts.Add($"\"maxTokens\":{_editMaxTokens}");
            if (AiModuleOptions.SupportsReasoningEffort(providerType, modelName)
                && !string.IsNullOrWhiteSpace(_editReasoningEffort))
                parts.Add($"\"reasoningEffort\":\"{_editReasoningEffort}\"");
            if (AiModuleOptions.SupportsWebSearch(providerType, moduleType))
                parts.Add($"\"webSearch\":{(_editWebSearch ? "true" : "false")}");
        }
        else if (moduleType == "Image" && providerType == "Google")
        {
            if (!string.IsNullOrWhiteSpace(_editSystemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_editSystemPrompt)}");
            if (_editGeminiAspectRatio != "1:1")
                parts.Add($"\"aspectRatio\":\"{_editGeminiAspectRatio}\"");
            if (_editGeminiImageCount != 1)
                parts.Add($"\"numberOfImages\":{_editGeminiImageCount}");
        }
        else if (moduleType == "Image" && providerType == "xAI")
        {
            if (!string.IsNullOrWhiteSpace(_editSystemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_editSystemPrompt)}");
            if (_editGrokImageCount != 1)
                parts.Add($"\"n\":{_editGrokImageCount}");
        }
        else if (moduleType == "Video")
        {
            if (!string.IsNullOrWhiteSpace(_editVideoPrompt))
                parts.Add($"\"videoPrompt\":{System.Text.Json.JsonSerializer.Serialize(_editVideoPrompt)}");
            if (_editVideoResolution != "RESOLUTION_480")
                parts.Add($"\"resolution\":\"{_editVideoResolution}\"");
            if (_editVideoFrameInterpolation != "true")
                parts.Add($"\"frameInterpolation\":{_editVideoFrameInterpolation}");
        }
        else if (moduleType == "Image" && providerType == "LeonardoAI")
        {
            if (!string.IsNullOrWhiteSpace(_editSystemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_editSystemPrompt)}");
            if (_editLeoWidth != 1024)
                parts.Add($"\"width\":{_editLeoWidth}");
            if (_editLeoHeight != 1024)
                parts.Add($"\"height\":{_editLeoHeight}");
            if (_editLeoPresetStyle != "DYNAMIC")
                parts.Add($"\"presetStyle\":\"{_editLeoPresetStyle}\"");
        }
        else if (moduleType == "Image")
        {
            if (!string.IsNullOrWhiteSpace(_editSystemPrompt))
                parts.Add($"\"systemPrompt\":{System.Text.Json.JsonSerializer.Serialize(_editSystemPrompt)}");
            if (_editImageSize != "1024x1024")
                parts.Add($"\"size\":\"{_editImageSize}\"");
            // La calidad se escribe siempre: si se omite, la API aplica "auto",
            // que en gpt-image resuelve al tramo mas caro (high).
            if (providerType == "OpenAI" && AiModuleOptions.SupportsQuality(modelName))
                parts.Add($"\"quality\":\"{_editImageQuality}\"");
        }
        else if (moduleType == "Audio")
        {
            parts.Add($"\"voice\":\"{_editTtsVoice}\"");
            if (_editTtsSpeed != 1.0)
                parts.Add($"\"speed\":{_editTtsSpeed}");
            if (!string.IsNullOrWhiteSpace(_editTtsInstructions))
                parts.Add($"\"voiceInstructions\":{System.Text.Json.JsonSerializer.Serialize(_editTtsInstructions)}");
        }
        else if (moduleType == "Design" && providerType == "Canva")
        {
            if (!string.IsNullOrWhiteSpace(_editCanvaAccessToken))
                parts.Add($"\"accessToken\":{System.Text.Json.JsonSerializer.Serialize(_editCanvaAccessToken)}");
            if (_editCanvaExportFormat != "png")
                parts.Add($"\"exportFormat\":\"{_editCanvaExportFormat}\"");
            if (!string.IsNullOrWhiteSpace(_editCanvaBrandTemplate))
                parts.Add($"\"brandTemplateId\":{System.Text.Json.JsonSerializer.Serialize(_editCanvaBrandTemplate)}");
            if (_editCanvaDesignType != "doc")
                parts.Add($"\"designType\":\"{_editCanvaDesignType}\"");
        }
        if (moduleType == "StaticText")
        {
            if (!string.IsNullOrWhiteSpace(_editStaticTextContent))
                parts.Add($"\"content\":{System.Text.Json.JsonSerializer.Serialize(_editStaticTextContent)}");
        }

        return parts.Count > 0 ? "{" + string.Join(",", parts) + "}" : null;
    }

    private async Task Delete(Guid moduleId)
    {
        try { await Api.DeleteModuleAsync(moduleId); _modules = await Api.GetModulesAsync(); }
        catch { }
    }
}
