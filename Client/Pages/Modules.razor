    private sealed record StatBar(string Label, string Icon, string Tone, int Percent, string Value);
    private sealed record ModelStats(List<StatBar> Bars);

    /// <summary>
    /// Estadisticas de cada modelo, relativas al resto de candidatos del mismo tipo
    /// y proveedor: economia (precio invertido, escala log), contexto (escala log) y
    /// versatilidad (numero de capacidades). Solo se pinta lo que hay dato.
    /// </summary>
    private Dictionary<string, ModelStats> ComputeStats(List<ModelInfo> models)
    {
        decimal? Cost(ModelInfo m)
        {
            if (!_pricing.TryGetValue(m.Id, out var p)) return null;
            var c = p.Kind switch
            {
                "text"  => p.CostFor(10_000, 2_000),
                "image" => p.ImageMedium ?? 0m,
                _       => p.AuxAmount ?? 0m,
            };
            return c > 0m ? c : null;
        }
        string CostText(ModelInfo m, decimal c) =>
            _pricing.TryGetValue(m.Id, out var p) && p.Kind == "image" ? $"${c:0.000} / img"
            : _pricing.TryGetValue(m.Id, out var q) && q.Kind == "text" ? $"${c:0.0000} / ejec."
            : $"${c:0.000}";
        long? Ctx(ModelInfo m)
        {
            if (_pricing.TryGetValue(m.Id, out var p) && p.ContextTokens is > 0) return p.ContextTokens;
            if (m.MaxContext is null) return null;
            var t = m.MaxContext.Trim().ToUpperInvariant();
            if (t.EndsWith("M") && double.TryParse(t[..^1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var mm)) return (long)(mm * 1_000_000);
            if (t.EndsWith("K") && double.TryParse(t[..^1], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var kk)) return (long)(kk * 1_000);
            return null;
        }
        static int LogPct(double v, double min, double max) =>
            max <= min ? 100 : (int)Math.Round(20 + 80 * (Math.Log10(v) - Math.Log10(min)) / (Math.Log10(max) - Math.Log10(min)));

        var costs = models.Select(Cost).Where(c => c is not null).Select(c => (double)c!.Value).ToList();
        var ctxs = models.Select(Ctx).Where(c => c is not null).Select(c => (double)c!.Value).ToList();
        var maxCaps = Math.Max(1, models.Max(m => m.Capabilities.Length));

        var result = new Dictionary<string, ModelStats>();
        foreach (var m in models)
        {
            var bars = new List<StatBar>();
            if (Cost(m) is { } c && costs.Count > 0)
            {
                // Mas barato = barra mas llena.
                var pct = 120 - LogPct((double)c, costs.Min(), costs.Max());
                bars.Add(new("Economia", "bi-piggy-bank", "#34d399", Math.Clamp(pct, 20, 100), CostText(m, c)));
            }
            if (Ctx(m) is { } x && ctxs.Count > 0)
                bars.Add(new("Contexto", "bi-arrows-angle-expand", "#22d3ee", LogPct(x, ctxs.Min(), ctxs.Max()),
                    x >= 1_000_000 ? $"{x / 1_000_000d:0.#}M" : $"{x / 1_000d:0}K"));
            bars.Add(new("Versatilidad", "bi-stars", "#8b83ff", (int)Math.Round(100.0 * m.Capabilities.Length / maxCaps),
                $"{m.Capabilities.Length} {(m.Capabilities.Length == 1 ? "capacidad" : "capacidades")}"));
            result[m.Id] = new ModelStats(bars);
        }
        return result;
    }

