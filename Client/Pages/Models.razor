@* Catalogo de modelos: que hay, que sabe hacer cada uno y cuanto cuesta.

   La ruta /precios se mantiene porque la pantalla se llamaba asi y hay enlaces
   guardados apuntando ahi. *@
@page "/modelos"
@page "/precios"
@inject ApiClient Api

<div class="page-header">
    <div class="page-title">
        <h2>Modelos</h2>
        <p>Compara tarifas, capacidades y contexto de cada modelo antes de elegirlo para un módulo.</p>
    </div>
</div>

@if (_loading)
{
    <PageLoader Variant="charts" Rows="4" Stats="4" Label="Cargando catalogo de modelos..." />
}
else if (_models.Count == 0)
{
    <div class="empty-hero is-compact">
        <div class="empty-hero-icon"><i class="bi bi-cloud-slash"></i></div>
        <h3>No se ha podido cargar el catálogo</h3>
        <p>Revisa la conexión con el servidor y vuelve a intentarlo.</p>
        <button class="btn btn-secondary" @onclick="ReloadAsync"><i class="bi bi-arrow-clockwise"></i> Reintentar</button>
    </div>
}
else
{
    var cheapest = _models
        .Where(m => m.Kind == "text" && m.Lifecycle.Status != "retired" && (m.InputPerMTok ?? 0) + (m.OutputPerMTok ?? 0) > 0)
        .OrderBy(m => m.CostFor(_inputTokens, _outputTokens))
        .FirstOrDefault();
    var biggest = _models.Where(m => m.ContextTokens is > 0).OrderByDescending(m => m.ContextTokens).FirstOrDefault();
    var warnings = _models.Count(m => m.Lifecycle.Status is "deprecated" or "retired");

    <div class="stat-row">
        <div class="stat-tile">
            <span class="stat-icon tone-violet"><i class="bi bi-cpu"></i></span>
            <div><strong>@_models.Count</strong><span>Modelos de @_providers.Count proveedores</span></div>
        </div>
        <div class="stat-tile">
            <span class="stat-icon tone-green"><i class="bi bi-piggy-bank"></i></span>
            <div>
                <strong>@(cheapest is null ? "—" : Money(cheapest.CostFor(_inputTokens, _outputTokens), 4))</strong>
                <span title="Modelo de texto mas barato con los tokens indicados">@(cheapest?.DisplayName ?? "Texto más barato") · por ejecución</span>
            </div>
        </div>
        <div class="stat-tile">
            <span class="stat-icon tone-cyan"><i class="bi bi-arrows-angle-expand"></i></span>
            <div>
                <strong>@(biggest is null ? "—" : Tokens(biggest.ContextTokens!.Value))</strong>
                <span>Mayor contexto · @(biggest?.DisplayName ?? "")</span>
            </div>
        </div>
        <div class="stat-tile @(warnings > 0 ? "is-warning" : "")">
            <span class="stat-icon tone-amber"><i class="bi bi-hourglass-split"></i></span>
            <div><strong>@warnings</strong><span>Retirados o por retirar</span></div>
        </div>
    </div>

    <div class="page-toolbar">
        <div class="seg-filters">
            <button class="seg-filter @(_view == View.Charts ? "active" : "")" @onclick="() => _view = View.Charts">
                <i class="bi bi-bar-chart-line"></i> Comparativa
            </button>
            <button class="seg-filter @(_view == View.Table ? "active" : "")" @onclick="() => _view = View.Table">
                <i class="bi bi-table"></i> Tabla
            </button>
            <button class="seg-filter @(_view == View.Changes ? "active" : "")" @onclick="() => _view = View.Changes">
                <i class="bi bi-clock-history"></i> Cambios
            </button>
        </div>
        @if (_view != View.Changes)
        {
            <div class="search-box models-search">
                <i class="bi bi-search"></i>
                <input type="text" @bind="_search" @bind:event="oninput" placeholder="Buscar modelo..." />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button class="search-box-clear" title="Limpiar" @onclick='() => _search = ""'><i class="bi bi-x-lg"></i></button>
                }
            </div>
        }
    </div>

    @if (_view == View.Changes)
    {
        <ModelScanPanel OnScanned="ReloadAsync" />
    }
    else
    {
        var ofType = _models.Where(m => m.ModuleType == _moduleType).ToList();
        var visible = ofType.Where(Matches).ToList();
        var kind = ofType.Select(m => m.Kind).FirstOrDefault() ?? "text";

        @* ── Filtros: el tipo va primero y es obligatorio. Cada tipo se factura con
           una unidad distinta, asi que comparar texto con imagen no tenia sentido y
           solo alargaba las graficas y las tablas. ── *@
        <div class="models-filters">
            <div class="models-filter-group">
                <span class="models-filter-label">Tipo</span>
                <div class="seg-filters">
                    @foreach (var t in _moduleTypes)
                    {
                        <button class="seg-filter @(_moduleType == t ? "active" : "")" @onclick="() => SelectType(t)">
                            <i class="bi @ModuleTypeIcon(t)"></i> @ModuleTypeLabel(t)
                            <span class="seg-filter-count">@_models.Count(m => m.ModuleType == t)</span>
                        </button>
                    }
                </div>
            </div>

            <div class="models-filter-group">
                <span class="models-filter-label">Empresa</span>
                <div class="apikeys-filters">
                    <button class="filter-pill @(_provider is null ? "active" : "")" @onclick="() => _provider = null">
                        Todas <span class="filter-count">@ofType.Count</span>
                    </button>
                    @foreach (var p in ofType.Select(m => m.Provider).Distinct().OrderBy(x => x))
                    {
                        <button class="filter-pill @ProviderPalette.PillClass(p) @(_provider == p ? "active" : "")"
                                @onclick="() => _provider = p">
                            <ProviderIcon Provider="@p" Size="13" /> @p
                            <span class="filter-count">@ofType.Count(m => m.Provider == p)</span>
                        </button>
                    }
                </div>
            </div>

            @{ var caps = ofType.SelectMany(m => m.Caps).Select(CapLabel).Distinct().OrderBy(x => x).ToList(); }
            @if (caps.Count > 1)
            {
                @* Las capacidades se acumulan: marcar "Vision" y "Razonamiento" busca
                   modelos que tengan las dos, que es como se elige un modelo de verdad. *@
                <div class="models-filter-group">
                    <span class="models-filter-label">Capacidades</span>
                    <div class="apikeys-filters">
                        @foreach (var cap in caps)
                        {
                            <button class="filter-pill @(_caps.Contains(cap) ? "active" : "")" @onclick="() => ToggleCap(cap)">
                                @cap
                            </button>
                        }
                        @if (_caps.Count > 0)
                        {
                            <button class="filter-pill models-clear" @onclick="() => _caps.Clear()">
                                <i class="bi bi-x"></i> Quitar
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="models-filter-group models-filter-options">
                <span class="models-filter-label">Opciones</span>
                <div class="pricing-tokens">
                    @if (kind == "text")
                    {
                        @* Los campos se recalculan al salir del campo, no en cada tecla: con binding a
                           int, el instante en que el campo queda vacio al reescribirlo es un error de
                           parseo y Blazor revierte el valor delante del usuario. *@
                        <label>
                            Tokens de entrada
                            <input type="number" min="0" step="500" @bind="_inputTokens" />
                        </label>
                        <label>
                            Tokens de salida
                            <input type="number" min="0" step="500" @bind="_outputTokens" />
                        </label>
                        <button class="btn btn-sm btn-secondary" @onclick="ResetTokens">Restablecer</button>
                    }
                    <label class="models-check">
                        <input type="checkbox" @bind="_hideRetired" />
                        Ocultar retirados
                    </label>
                </div>
            </div>
        </div>

        <p class="models-count">
            @visible.Count de @ofType.Count modelos de @ModuleTypeLabel(_moduleType).ToLowerInvariant()
            @if (kind == "text" && visible.Count > 0)
            {
                <span class="models-count-note">
                    · coste calculado sobre @_inputTokens.ToString("N0") tokens de entrada
                    y @_outputTokens.ToString("N0") de salida
                </span>
            }
        </p>

        @if (visible.Count == 0)
        {
            <div class="empty-hero is-compact">
                <div class="empty-hero-icon"><i class="bi bi-funnel"></i></div>
                <h3>Sin resultados</h3>
                <p>Ningún modelo cumple todos los filtros.</p>
                <button class="btn btn-secondary" @onclick="ClearFilters">Limpiar filtros</button>
            </div>
        }
        else if (_view == View.Charts)
        {
            @RenderPicks(visible, kind)

            var rows = _showAll ? 200 : ChartRows;

            <div class="charts-grid">
                @if (kind == "text")
                {
                    <ModelBarChart
                        Title="Coste por ejecucion"
                        Note="@($"{_inputTokens:N0} tokens dentro, {_outputTokens:N0} fuera · escala logaritmica")"
                        Log="true"
                        MaxRows="rows"
                        Bars="@CostBars(visible)" />

                    <ModelBarChart
                        Title="Ventana de contexto"
                        Note="tokens que caben en una llamada"
                        MaxRows="rows"
                        Bars="@ContextBars(visible)" />

                    <div class="charts-wide">
                        <ModelScatterChart
                            Title="Precio frente a capacidad"
                            Note="cuanto mas abajo y a la derecha, mas contexto por dolar"
                            XLabel="coste por ejecucion (USD)"
                            YLabel="ventana de contexto (tokens)"
                            Points="@CostVsContext(visible)" />
                    </div>
                }
                else if (kind == "image")
                {
                    @* Fuera de gpt-image la calidad no cambia el precio: tres barras
                       identicas por modelo no comparan nada, asi que los planos van en
                       su propia grafica con una sola barra. *@
                    @if (visible.Any(ByQuality))
                    {
                        <ModelBarChart
                            Title="Coste por imagen segun calidad"
                            Note="1024x1024 · escala logaritmica"
                            Log="true"
                            MaxRows="rows"
                            SeriesNames="@(new[] { "baja", "media", "alta" })"
                            Bars="@ImageBars(visible.Where(ByQuality).ToList())" />
                    }
                    @if (visible.Any(m => !ByQuality(m)))
                    {
                        <ModelBarChart
                            Title="Coste por imagen"
                            Note="precio unico por imagen de 1024x1024 · escala logaritmica"
                            Log="true"
                            MaxRows="rows"
                            Bars="@FlatImageBars(visible.Where(m => !ByQuality(m)).ToList())" />
                    }
                }
                else
                {
                    @* Embeddings, audio y transcripcion no comparten unidad de facturacion:
                       una grafica por unidad, porque un grafico que mezcle dolares por
                       minuto con dolares por millon de tokens compara cosas distintas. *@
                    @foreach (var group in AuxGroups(visible))
                    {
                        <ModelBarChart
                            Title="@($"Precio por {group.Key}")"
                            Note="@AuxNoteFor(group.Key)"
                            Log="true"
                            MaxRows="rows"
                            Bars="@group.Value" />
                    }
                }
            </div>

            @if (visible.Count > ChartRows)
            {
                <div class="models-more">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _showAll = !_showAll">
                        <i class="bi @(_showAll ? "bi-chevron-up" : "bi-chevron-down")"></i>
                        @(_showAll ? $"Mostrar solo los {ChartRows} primeros" : $"Ver los {visible.Count} modelos en las gráficas")
                    </button>
                </div>
            }
        }
        else
        {
            @RenderTable(visible, kind)
        }

        <p class="text-muted pricing-footnote">
            Ningun proveedor publica sus tarifas por API, asi que estan en una tabla revisada
            a mano (<code>Server/Services/Ai/PricingCatalog.cs</code>) y son las mismas que usa
            la app para estimar el gasto de cada ejecucion. El coste real depende de los tokens
            que gaste cada una, y en los modelos de razonamiento el pensar se factura como
            salida. La pestaña <strong>Cambios</strong> lleva el registro de cuando se movio
            cada precio y de que modelos nuevos han aparecido en los proveedores.
        </p>
    }
}

@code {
    private enum View { Charts, Table, Changes }

    private List<ModelPriceResponse> _models = [];
    private List<string> _providers = [];
    private List<string> _moduleTypes = [];

    private bool _loading = true;
    private View _view = View.Charts;

    private string? _provider;
    private string _moduleType = "Text";
    // Etiquetas de capacidad marcadas (no los ids: "image-edit" e "image-editing"
    // son la misma capacidad y antes salian dos pastillas iguales).
    private readonly HashSet<string> _caps = [];

    // Las graficas ensenan los primeros ChartRows; el resto, bajo demanda.
    private const int ChartRows = 12;
    private bool _showAll;

    // Orden de la tabla: columna y sentido. Por defecto, lo mas barato primero.
    private string _sortKey = "cost";
    private bool _sortDesc;
    private string _search = "";
    private bool _hideRetired;

    // Un paso de texto tipico del pipeline: un articulo corto con su prompt de sistema.
    private const int DefaultInputTokens = 10_000;
    private const int DefaultOutputTokens = 2_000;

    private int _inputTokens = DefaultInputTokens;
    private int _outputTokens = DefaultOutputTokens;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try { _models = await Api.GetModelPricingAsync(); }
        catch { }

        _providers = _models.Select(m => m.Provider).Distinct().OrderBy(p => p).ToList();

        // El orden no es alfabetico a proposito: texto e imagen son el 90% del uso.
        string[] order = ["Text", "Image", "Embeddings", "Audio", "Transcription", "Design"];
        _moduleTypes = order.Where(t => _models.Any(m => m.ModuleType == t))
            .Concat(_models.Select(m => m.ModuleType).Distinct().Where(t => !order.Contains(t)))
            .ToList();
        if (_moduleTypes.Count > 0 && !_moduleTypes.Contains(_moduleType)) _moduleType = _moduleTypes[0];

        _loading = false;
    }

    private void ResetTokens()
    {
        _inputTokens = DefaultInputTokens;
        _outputTokens = DefaultOutputTokens;
    }

    private void ToggleCap(string cap)
    {
        if (!_caps.Add(cap)) _caps.Remove(cap);
    }

    private void SelectType(string type)
    {
        if (_moduleType == type) return;
        _moduleType = type;
        // Proveedor y capacidades dependen del tipo: se reinician para no dejar
        // un filtro invisible que vacie la lista.
        _provider = null;
        _caps.Clear();
        _showAll = false;
        _sortKey = "cost";
        _sortDesc = false;
    }

    private void ClearFilters()
    {
        _provider = null;
        _caps.Clear();
        _search = "";
        _hideRetired = false;
    }

    private void SortBy(string key)
    {
        if (_sortKey == key) _sortDesc = !_sortDesc;
        else { _sortKey = key; _sortDesc = key is "context" or "prompt"; }
    }

    private bool Matches(ModelPriceResponse m) =>
        (_provider is null || m.Provider == _provider)
        && (!_hideRetired || m.Lifecycle.Status != "retired")
        && _caps.All(label => m.Caps.Any(c => CapLabel(c) == label))
        && (string.IsNullOrWhiteSpace(_search)
            || m.Id.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || m.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase));

    // ────────────────────────────── graficas ──────────────────────────────

    /// <summary>Coste de una ejecucion con los tokens que tenga puestos el usuario.</summary>
    private List<ChartBar> CostBars(List<ModelPriceResponse> models) => models
        .OrderBy(m => m.CostFor(_inputTokens, _outputTokens))
        .Select(m => new ChartBar(m.DisplayName, m.Id, m.Provider,
            [new ChartValue(m.CostFor(_inputTokens, _outputTokens),
                Money(m.CostFor(_inputTokens, _outputTokens), 4))]))
        .ToList();

    private static List<ChartBar> ContextBars(List<ModelPriceResponse> models) => models
        .Where(m => m.ContextTokens is > 0)
        .OrderByDescending(m => m.ContextTokens)
        .Select(m => new ChartBar(m.DisplayName, m.Id, m.Provider,
            [new ChartValue(m.ContextTokens!.Value, Tokens(m.ContextTokens.Value))]))
        .ToList();

    private List<ChartPoint> CostVsContext(List<ModelPriceResponse> models) => models
        .Where(m => m.ContextTokens is > 0)
        .Select(m =>
        {
            var cost = m.CostFor(_inputTokens, _outputTokens);
            return new ChartPoint(m.DisplayName, (double)cost, m.ContextTokens!.Value, m.Provider,
                $"{m.DisplayName} ({m.Id})\n{Money(cost, 4)} por ejecucion\n"
                + $"{Tokens(m.ContextTokens.Value)} de contexto");
        })
        .ToList();

    /// <summary>True cuando el modelo cobra distinto segun la calidad pedida.</summary>
    private static bool ByQuality(ModelPriceResponse m) =>
        !(m.ImageLow == m.ImageMedium && m.ImageMedium == m.ImageHigh);

    private static List<ChartBar> FlatImageBars(List<ModelPriceResponse> models) => models
        .OrderBy(m => m.ImageMedium ?? 0m)
        .Select(m => new ChartBar(m.DisplayName, m.Id, m.Provider,
            [new ChartValue(m.ImageMedium ?? 0m, Money(m.ImageMedium, 4))]))
        .ToList();

    private static List<ChartBar> ImageBars(List<ModelPriceResponse> models) => models
        .OrderBy(m => m.ImageMedium ?? 0m)
        .Select(m => new ChartBar(m.DisplayName, m.Id, m.Provider,
        [
            new ChartValue(m.ImageLow ?? 0m, Money(m.ImageLow, 4)),
            new ChartValue(m.ImageMedium ?? 0m, Money(m.ImageMedium, 4)),
            new ChartValue(m.ImageHigh ?? 0m, Money(m.ImageHigh, 4)),
        ]))
        .ToList();

    /// <summary>
    /// Modelos que no se facturan ni por token ni por imagen, agrupados por su unidad.
    /// Mezclar dolares por minuto con dolares por millon de caracteres en la misma
    /// escala seria equivocarse por tres ordenes de magnitud.
    /// </summary>
    private static Dictionary<string, List<ChartBar>> AuxGroups(List<ModelPriceResponse> models) => models
        .Where(m => m.Kind == "other" && m.AuxAmount is > 0m && m.AuxUnit is not null)
        .GroupBy(m => m.AuxUnit!)
        .OrderBy(g => g.Key)
        .ToDictionary(
            g => g.Key,
            g => g.OrderBy(m => m.AuxAmount)
                  .Select(m => new ChartBar(m.DisplayName, m.Id, m.Provider,
                      [new ChartValue(m.AuxAmount!.Value, Money(m.AuxAmount, m.AuxAmount < 1m ? 4 : 2))]))
                  .ToList());

    private static string AuxNoteFor(string unit) =>
        unit.Contains("minuto") ? "transcripcion · escala logaritmica"
        : unit.Contains("caracter") ? "voz · escala logaritmica"
        : "escala logaritmica";

    // ────────────────────────────── destacados ──────────────────────────────

    private sealed record Pick(string Title, string Icon, string Tone, ModelPriceResponse Model, string Value, string Note);

    /// <summary>
    /// Respuestas directas a las preguntas que se hacen al elegir modelo (cual es el
    /// mas barato, cual da mas contexto por dolar...), para no tener que leerlas en
    /// las graficas.
    /// </summary>
    private List<Pick> Picks(List<ModelPriceResponse> models, string kind)
    {
        var picks = new List<Pick>();
        var live = models.Where(m => m.Lifecycle.Status != "retired").ToList();
        if (live.Count == 0) live = models;

        if (kind == "text")
        {
            var priced = live.Where(m => m.CostFor(_inputTokens, _outputTokens) > 0m).ToList();
            var cheap = priced.MinBy(m => m.CostFor(_inputTokens, _outputTokens));
            if (cheap is not null)
                picks.Add(new("Más económico", "bi-piggy-bank", "#34d399", cheap,
                    Money(cheap.CostFor(_inputTokens, _outputTokens), 4), "por ejecución"));

            var value = priced.Where(m => m.ContextTokens is > 0)
                .MaxBy(m => m.ContextTokens!.Value / (double)m.CostFor(_inputTokens, _outputTokens));
            if (value is not null)
                picks.Add(new("Más contexto por dólar", "bi-graph-up-arrow", "#22d3ee", value,
                    Tokens(value.ContextTokens!.Value), $"{Money(value.CostFor(_inputTokens, _outputTokens), 4)} por ejecución"));

            var big = live.Where(m => m.ContextTokens is > 0).MaxBy(m => m.ContextTokens);
            if (big is not null)
                picks.Add(new("Mayor contexto", "bi-arrows-angle-expand", "#8b83ff", big,
                    Tokens(big.ContextTokens!.Value), "tokens por llamada"));

            var reasoning = priced.Where(m => m.Caps.Contains("reasoning"))
                .MinBy(m => m.CostFor(_inputTokens, _outputTokens));
            if (reasoning is not null)
                picks.Add(new("Razonamiento más barato", "bi-lightbulb", "#f59e0b", reasoning,
                    Money(reasoning.CostFor(_inputTokens, _outputTokens), 4), "por ejecución"));
        }
        else if (kind == "image")
        {
            var cheap = live.Where(m => m.ImageMedium is > 0m).MinBy(m => m.ImageMedium);
            if (cheap is not null)
                picks.Add(new("Imagen más barata", "bi-piggy-bank", "#34d399", cheap,
                    Money(cheap.ImageMedium, 4), "por imagen (calidad media)"));

            var high = live.Where(m => m.ImageHigh is > 0m).MinBy(m => m.ImageHigh);
            if (high is not null)
                picks.Add(new("Alta calidad más barata", "bi-stars", "#8b83ff", high,
                    Money(high.ImageHigh, 4), "por imagen (calidad alta)"));

            var edit = live.Where(m => m.Caps.Any(c => CapLabel(c) == "Edita imagen") && m.ImageMedium is > 0m)
                .MinBy(m => m.ImageMedium);
            if (edit is not null)
                picks.Add(new("Edición más barata", "bi-brush", "#f59e0b", edit,
                    Money(edit.ImageMedium, 4), "por imagen editada"));
        }
        else
        {
            foreach (var g in live.Where(m => m.AuxAmount is > 0m && m.AuxUnit is not null)
                                  .GroupBy(m => m.AuxUnit!).Take(4))
            {
                var cheap = g.MinBy(m => m.AuxAmount)!;
                picks.Add(new($"Más barato por {g.Key}", "bi-piggy-bank", "#34d399", cheap,
                    Money(cheap.AuxAmount, cheap.AuxAmount < 1m ? 4 : 2), $"por {g.Key}"));
            }
        }

        return picks;
    }

    private RenderFragment RenderPicks(List<ModelPriceResponse> models, string kind) => __builder =>
    {
        var picks = Picks(models, kind);
        if (picks.Count == 0) return;

        <div class="models-picks">
            @foreach (var pick in picks)
            {
                @* Pulsar un destacado lo localiza en la tabla. *@
                <button class="models-pick" style="--tone:@pick.Tone" title="Ver en la tabla"
                        @onclick="() => { _search = pick.Model.Id; _view = View.Table; }">
                    <span class="models-pick-head"><i class="bi @pick.Icon"></i> @pick.Title</span>
                    <strong class="models-pick-value">@pick.Value</strong>
                    <span class="models-pick-note">@pick.Note</span>
                    <span class="models-pick-model">
                        <ProviderIcon Provider="@pick.Model.Provider" Size="13" /> @pick.Model.DisplayName
                    </span>
                </button>
            }
        </div>
    };

    // ────────────────────────────── tabla ──────────────────────────────

    /// <summary>
    /// Una sola tabla con las columnas del tipo elegido. Antes eran tres tablas
    /// apiladas con filas de grupo por proveedor; ahora el proveedor es una columna
    /// y cualquier columna numerica ordena al pulsar su cabecera.
    /// </summary>
    private RenderFragment RenderTable(List<ModelPriceResponse> models, string kind) => __builder =>
    {
        var rows = Sorted(models, kind);

        <div class="table-wrap models-table-wrap">
            <table class="data-table pricing-table">
                <thead>
                    <tr>
                        @SortHeader("name", "Modelo", false)
                        @SortHeader("provider", "Proveedor", false)
                        @if (kind == "text")
                        {
                            @SortHeader("cost", "Por ejecución", true)
                            @SortHeader("input", "$ / 1M entrada", true)
                            @SortHeader("output", "$ / 1M salida", true)
                            @SortHeader("context", "Contexto", true)
                            <th>Capacidades</th>
                        }
                        else if (kind == "image")
                        {
                            @SortHeader("low", "Baja", true)
                            @SortHeader("cost", "Media", true)
                            @SortHeader("high", "Alta", true)
                            @SortHeader("prompt", "Prompt máx.", true)
                        }
                        else
                        {
                            @SortHeader("cost", "Precio", true)
                            <th>Unidad</th>
                        }
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in rows)
                    {
                        <tr class="@(m.Lifecycle.Status == "retired" ? "row-inactive" : "")">
                            <td>
                                <span class="pricing-name">@m.DisplayName</span>
                                <span class="pricing-id">@m.Id</span>
                            </td>
                            <td>
                                <span class="pricing-provider-cell">
                                    <ProviderIcon Provider="@m.Provider" Size="14" /> @m.Provider
                                </span>
                            </td>
                            @if (kind == "text")
                            {
                                <td class="num num-strong">@Money(m.CostFor(_inputTokens, _outputTokens), 4)</td>
                                <td class="num">@Money(m.InputPerMTok, 3)</td>
                                <td class="num">@Money(m.OutputPerMTok, 2)</td>
                                <td class="num">@(m.ContextTokens is > 0 ? Tokens(m.ContextTokens.Value) : "—")</td>
                                <td>@CapChips(m)</td>
                            }
                            else if (kind == "image")
                            {
                                @if (!ByQuality(m))
                                {
                                    @* Fuera de gpt-image la calidad no cambia el precio: repetir
                                       tres veces la misma cifra solo invita a leerla mal. *@
                                    <td class="num" colspan="3">
                                        @Money(m.ImageMedium, 4) <span class="pricing-flat">precio unico</span>
                                    </td>
                                }
                                else
                                {
                                    <td class="num">@Money(m.ImageLow, 4)</td>
                                    <td class="num num-strong">@Money(m.ImageMedium, 4)</td>
                                    <td class="num">@Money(m.ImageHigh, 4)</td>
                                }
                                <td class="num">@(m.PromptChars is > 0 ? $"{m.PromptChars.Value:N0}" : "—")</td>
                            }
                            else
                            {
                                <td class="num num-strong">
                                    @(m.AuxAmount is null ? "—" : Money(m.AuxAmount, m.AuxAmount < 1m ? 4 : 2))
                                </td>
                                <td class="pricing-unit">
                                    @if (m.AuxUnit is not null)
                                    {
                                        <span>por @m.AuxUnit</span>
                                    }
                                    else
                                    {
                                        <span class="pricing-flat">sin coste por uso</span>
                                    }
                                    @if (m.AuxNote is not null)
                                    {
                                        <span class="pricing-aux-note">@m.AuxNote</span>
                                    }
                                </td>
                            }
                            <td><ModelLifecycleBadge Info="@m.Lifecycle" Compact="true" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment SortHeader(string key, string label, bool numeric) => __builder =>
    {
        var active = _sortKey == key;
        <th class="@(numeric ? "num" : "")">
            <button class="sort-btn @(active ? "is-active" : "")" @onclick="() => SortBy(key)">
                @label
                <i class="bi @(active ? (_sortDesc ? "bi-arrow-down" : "bi-arrow-up") : "bi-arrow-down-up")"></i>
            </button>
        </th>
    };

    private List<ModelPriceResponse> Sorted(List<ModelPriceResponse> models, string kind)
    {
        // Los valores que faltan van siempre al final, sea cual sea el sentido.
        IComparable? Key(ModelPriceResponse m) => _sortKey switch
        {
            "name"     => m.DisplayName,
            "provider" => m.Provider,
            "input"    => m.InputPerMTok,
            "output"   => m.OutputPerMTok,
            "context"  => m.ContextTokens is > 0 ? m.ContextTokens : null,
            "low"      => m.ImageLow,
            "high"     => m.ImageHigh,
            "prompt"   => m.PromptChars is > 0 ? m.PromptChars : null,
            _          => kind switch
            {
                "text"  => m.CostFor(_inputTokens, _outputTokens),
                "image" => m.ImageMedium,
                _       => m.AuxAmount,
            },
        };

        var withKey = models.Where(m => Key(m) is not null);
        var ordered = _sortDesc ? withKey.OrderByDescending(Key) : withKey.OrderBy(Key);
        return ordered.Concat(models.Where(m => Key(m) is null)).ToList();
    }

    private RenderFragment CapChips(ModelPriceResponse m) => __builder =>
    {
        @* "Texto" en un modelo de texto no dice nada: se omite. *@
        @foreach (var cap in m.Caps.Select(CapLabel).Distinct().Where(c => !(m.Kind == "text" && c == "Texto")))
        {
            <span class="cap-chip">@cap</span>
        }
    };

    // ────────────────────────────── formato ──────────────────────────────

    private static string ModuleTypeIcon(string moduleType) => moduleType switch
    {
        "Text"          => "bi-fonts",
        "Image"         => "bi-image",
        "Embeddings"    => "bi-bounding-box-circles",
        "Audio"         => "bi-soundwave",
        "Transcription" => "bi-mic",
        "Design"        => "bi-palette",
        _               => "bi-cpu",
    };

    private static string ModuleTypeLabel(string moduleType) => moduleType switch
    {
        "Text"          => "Texto",
        "Image"         => "Imagen",
        "Embeddings"    => "Embeddings",
        "Audio"         => "Audio (TTS)",
        "Transcription" => "Transcripcion",
        "Design"        => "Diseno",
        _               => moduleType,
    };

    private static string CapLabel(string cap) => cap switch
    {
        "text"             => "Texto",
        "vision"           => "Vision",
        "reasoning"        => "Razonamiento",
        "streaming"        => "Streaming",
        "image-generation" => "Genera imagen",
        "image-edit"       => "Edita imagen",
        "image-editing"    => "Edita imagen",
        "embeddings"       => "Embeddings",
        "text-to-speech"   => "Voz",
        "speech-to-text"   => "Transcribe",
        "design-creation"  => "Diseno",
        "autofill"         => "Autofill",
        "export"           => "Exporta",
        "analytics"        => "Analitica",
        "seo"              => "SEO",
        "image-to-video"   => "Imagen a video",
        _                  => cap,
    };

    private static string Money(decimal? value, int decimals) =>
        value is null ? "—" : "$" + value.Value.ToString("N" + decimals);

    /// <summary>1_000_000 → "1M". El numero completo no aporta y no cabe en la barra.</summary>
    private static string Tokens(int tokens) =>
        tokens >= 1_000_000 ? (tokens / 1_000_000d).ToString("0.#") + "M"
        : tokens >= 1_000 ? (tokens / 1_000d).ToString("0") + "K"
        : tokens.ToString();
}
