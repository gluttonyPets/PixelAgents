@inject ApiClient Api
@inject AuthStateService AuthState
@implements IDisposable

<nav class="sidebar">
    <div class="sidebar-brand">PixelAgents</div>

    <NavLink href="/modules"><i class="bi bi-boxes"></i> Modulos IA</NavLink>
    <NavLink href="/modelos"><i class="bi bi-cpu"></i> Modelos</NavLink>
    <NavLink href="/biblioteca"><i class="bi bi-files"></i> Biblioteca</NavLink>
    <NavLink href="/projects"><i class="bi bi-kanban"></i> Proyectos</NavLink>
    @* Configuracion cierra el menu: es lo que menos se toca del dia a dia. *@
    <NavLink href="/configuracion"><i class="bi bi-gear"></i> Configuracion</NavLink>

    <div class="auth-status">
        @if (AuthState.IsAuthenticated)
        {
            <div>@AuthState.User!.Email</div>
            <button class="btn btn-sm btn-danger mt-1" @onclick="Logout">Cerrar sesión</button>
        }
        else
        {
            <button class="btn btn-sm btn-primary" @onclick="AuthState.RequireLogin">Iniciar sesión</button>
        }
        @if (_buildInfo is not null)
        {
            @* Dos lineas: en 220px de barra, commit y fecha juntos se salian y el
               SHA acababa cortado. *@
            <div class="build-info" title="@BuildTooltip()">
                <span class="build-info-commit">@_buildInfo.CommitHash</span>
                <span class="build-info-date">@_buildInfo.BuildDate</span>
            </div>
        }
    </div>
</nav>

@code {
    private Client.Models.BuildInfoResponse? _buildInfo;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += StateHasChanged;
        if (!AuthState.IsAuthenticated)
        {
            try
            {
                var user = await Api.GetMeAsync();
                if (user is not null) AuthState.SetUser(user);
            }
            catch { }
        }
        try { _buildInfo = await Api.GetBuildInfoAsync(); } catch { }
    }

    /// <summary>
    /// Detalle del sello para el tooltip: hash entero y origen del dato. Si el SHA
    /// del pie no cuadra con el que se espera, esto dice si viene del entorno del
    /// contenedor o de la imagen, que es por donde hay que empezar a mirar.
    /// </summary>
    private string BuildTooltip()
    {
        if (_buildInfo is null) return string.Empty;

        var commit = string.IsNullOrWhiteSpace(_buildInfo.CommitFull)
            ? _buildInfo.CommitHash
            : _buildInfo.CommitFull;

        var detail = $"Commit {commit}\nBuild del {_buildInfo.BuildDate} (hora de Madrid)";
        return string.IsNullOrWhiteSpace(_buildInfo.Source)
            ? detail
            : $"{detail}\nOrigen del sello: {_buildInfo.Source}";
    }

    private async Task Logout()
    {
        await Api.LogoutAsync();
        AuthState.SetUser(null);
    }

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
    }
}
